      .admin label.check input { width: auto; min-height: 0; margin: 0; }
      .admin .row { display: flex; gap: 12px; flex-wrap: wrap; }
      .admin .row > label { flex: 1 1 180px; }
      .admin .facts { width: 100%; border-collapse: collapse; }
