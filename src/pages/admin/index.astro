---
/**
 * 入稿画面。Cloudflare Access ＋ functions/_middleware.ts の二重で守る。
 *
 * ここで構造を強制するのが目的。Markdown の雛形だと「体験欄が空のまま」
 * 「金額に ¥ が混ざる」が通ってしまうので、保存の時点で弾く。
 *
 * 公開サイトの Base レイアウトは使わない（ヘッダもフッタも要らない）。
 */
import '../../styles/global.css';
import { CATEGORIES } from '../../config.ts';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>入稿 — Wayside Japan</title>
  </head>
  <body class="admin">
    <header class="bar">
      <strong>入稿</strong>
      <nav>
        <button type="button" id="new-btn" class="btn small">新規</button>
        <span id="who" class="who"></span>
      </nav>
    </header>

    <main class="layout">
      <aside class="list-pane">
        <div class="filter">
          <select id="filter-status">
            <option value="">すべて</option>
            <option value="draft">draft</option>
            <option value="ready">ready</option>
            <option value="written">written</option>
          </select>
        </div>
        <ul id="list" class="list"></ul>
      </aside>

      <section class="form-pane">
        <div class="tabs" role="tablist">
          <button type="button" class="tab" role="tab" data-type="guide" aria-selected="true">ガイド記事</button>
          <button type="button" class="tab" role="tab" data-type="column" aria-selected="false">コラム</button>
        </div>

        <form id="form" data-type="guide" novalidate>
          <p id="msg" class="msg" hidden></p>

          <fieldset>
            <legend>メタ</legend>
            <div class="row">
              <label>カテゴリ<select name="category" required>{CATEGORIES.map((c) => <option value={c}>{c}</option>)}</select></label>
              <label>状態<select name="status"><option value="draft">draft</option><option value="ready">ready</option><option value="written">written</option></select></label>
              <label>slug（URL。未定なら空）<input name="slug" placeholder="setouchi-area-pass" /></label>
            </div>
            <label>仮タイトル（日本語可）<input name="title" required /></label>
            <div class="row">
              <label>エリア（カンマ区切り）<input name="areas" placeholder="setouchi, onomichi" /></label>
              <label>パス<input name="passes" placeholder="setouchi-area-pass" /></label>
            </div>
            <div class="row">
              <label class="guide-only">根拠<select name="basis"><option value="visited">visited（自分で行った）</option><option value="researched">researched（調べて書く）</option></select></label>
              <label class="guide-only visited-only">取材日<input type="date" name="visitedOn" /></label>
              <label><span id="lbl-checked">料金確認日</span><input type="date" name="pricesCheckedOn" /></label>
              <label class="guide-only visited-only">移動手段<select name="mode"><option value="train">train</option><option value="bike">bike</option><option value="foot">foot</option><option value="">—</option></select></label>
            </div>
            <div class="row">
              <label>狙うクエリ<input name="query" placeholder="setouchi area pass worth it" /></label>
              <label class="guide-only">収益導線<select name="revenue"><option value="">なし（集客専用）</option><option value="tour">ツアー</option><option value="esim">eSIM</option><option value="hotel">宿</option></select></label>
              <label class="check guide-only visited-only"><input type="checkbox" name="photosOwn" checked /> 自前写真あり</label>
            </div>
          </fieldset>

          <fieldset class="guide-only">
            <legend>結論</legend>
            <label>向く<input name="buyIf" /></label>
            <label>向かない<input name="skipIf" /></label>
            <label>総額の目安（円・数字のみ）<input name="total" inputmode="numeric" /></label>
          </fieldset>

          <fieldset>
            <legend id="lg-facts">事実データ　★本文に出る数値はここだけ</legend>
            <table class="facts">
              <thead><tr><th>項目</th><th>値</th><th>証拠</th><th></th></tr></thead>
              <tbody id="facts"></tbody>
            </table>
            <button type="button" class="btn small ghost" data-add="fact">行を足す</button>
            <p class="hint" id="hint-facts">金額は数字のみ（22000）。¥ や「円」を入れない。不確かな値は頭に ? を付ける。</p>
          </fieldset>

          <fieldset id="cat-block">
            <legend>カテゴリ固有</legend>
            <div id="cat-fields" class="row"></div>
          </fieldset>

          <fieldset>
            <legend>セクション</legend>
            <div id="sections"></div>
            <button type="button" class="btn small ghost" data-add="section">セクションを足す</button>
            <p class="hint" id="hint-sections">「体験」か「実測」のどちらかが空だと保存できない。一般論で埋めさせないため。</p>
          </fieldset>

          <fieldset>
            <legend>FAQ（空でよい。候補は後で AI が出す）</legend>
            <div id="faqs"></div>
            <button type="button" class="btn small ghost" data-add="faq">Q&amp;A を足す</button>
          </fieldset>

          <fieldset>
            <legend id="lg-sources">出典（コラムは必須）</legend>
            <div id="sources"></div>
            <button type="button" class="btn small ghost" data-add="source">出典を足す</button>
          </fieldset>

          <fieldset class="guide-only">
            <legend>写真（内容で書く。番号は素材整理で自動）</legend>
            <textarea name="photos" rows="3" placeholder="福山の発車標&#10;尾道のホーム海側"></textarea>
          </fieldset>

          <fieldset>
            <legend>言い残し</legend>
            <textarea name="leftovers" rows="4"></textarea>
          </fieldset>

          <div class="actions">
            <button type="submit" class="btn">保存</button>
            <button type="button" id="json-btn" class="btn ghost">JSON をコピー</button>
            <button type="button" id="del-btn" class="btn ghost danger">削除</button>
          </div>
        </form>

        <pre id="json-out" class="json" hidden></pre>
      </section>
    </main>

    <script is:inline>
      const $ = (s, r = document) => r.querySelector(s);
      const api = '/api/intake';
      let currentId = null;

      const CAT_FIELDS = {
        rail: [['passOk', 'パス適用（対象/対象外）'], ['transfers', '乗換'], ['duration', '所要'], ['seat', '座席指定']],
        eat: [['shop', '店名'], ['price', '価格帯'], ['hours', '営業時間'], ['closed', '定休日'], ['englishMenu', '英語メニュー'], ['payment', '支払い']],
        soak: [['water', '泉質'], ['temp', '泉温'], ['entry', '入浴料（数字）'], ['hours', '営業時間'], ['closed', '定休日'],
               ['tattoos', '入れ墨（可/不可/条件付き）'], ['towel', 'タオル（備付/有料/持参）'], ['english', '英語対応'],
               ['fromStation', '駅から徒歩分'], ['bikeParking', 'バイク駐車']],
        konbini: [['chain', 'チェーン'], ['regional', '地域限定'], ['period', '販売期間'], ['price', '価格']],
        column: [['topic', '主題'], ['travelLink', 'なぜ旅と関係するか'], ['primarySource', '一次情報の出どころ']],
        ride: [['distance', '距離'], ['surface', '路面'], ['fuel', '給油所'], ['parking', '駐車'], ['season', '通行止め']],
      };

      function rowFact(v = {}) {
        const tr = document.createElement('tr');
        tr.innerHTML =
          '<td><input name="f_item" value="' + (v.item || '') + '"></td>' +
          '<td><input name="f_value" value="' + (v.value || '') + '"></td>' +
          '<td><input name="f_evidence" value="' + (v.evidence || '') + '" placeholder="写真07 / 公式URL / 実測"></td>' +
          '<td><button type="button" class="x" aria-label="削除">×</button></td>';
        tr.querySelector('.x').onclick = () => tr.remove();
        return tr;
      }

      function blockSection(v = {}) {
        const d = document.createElement('div');
        d.className = 'sec';
        d.innerHTML =
          '<label>見出し<input name="s_heading" value="' + (v.heading || '') + '"></label>' +
          '<div class="row guide-only"><label>運賃<input name="s_fare" value="' + (v.fare || '') + '"></label>' +
          '<label>所要<input name="s_time" value="' + (v.time || '') + '"></label>' +
          '<label>乗換<input name="s_transfer" value="' + (v.transfer || '') + '"></label>' +
          '<label>徒歩<input name="s_walk" value="' + (v.walk || '') + '"></label></div>' +
          '<label><span class="lbl-exp">体験（自分にしか書けないこと）</span><textarea name="s_experience" rows="2">' + (v.experience || '') + '</textarea></label>' +
          '<label><span class="lbl-mea">実測（自分で測った事実）</span><textarea name="s_measured" rows="2">' + (v.measured || '') + '</textarea></label>' +
          '<label>写真<input name="s_photos" value="' + (v.photos || '') + '"></label>' +
          '<label>メモ<textarea name="s_memo" rows="2">' + (v.memo || '') + '</textarea></label>' +
          '<button type="button" class="x" aria-label="削除">× このセクションを削除</button>';
        d.querySelector('.x').onclick = () => d.remove();
        return d;
      }

      function pair(cls, a, b, va = '', vb = '', pa = '', pb = '') {
        const d = document.createElement('div');
        d.className = 'row ' + cls;
        d.innerHTML =
          '<label>' + a + '<input name="' + cls + '_a" value="' + va + '" placeholder="' + pa + '"></label>' +
          '<label>' + b + '<input name="' + cls + '_b" value="' + vb + '" placeholder="' + pb + '"></label>' +
          '<button type="button" class="x" aria-label="削除">×</button>';
        d.querySelector('.x').onclick = () => d.remove();
        return d;
      }

      function renderCatFields(cat, values = {}) {
        const box = $('#cat-fields');
        box.innerHTML = '';
        (CAT_FIELDS[cat] || []).forEach(([k, label]) => {
          const l = document.createElement('label');
          l.innerHTML = label + '<input name="c_' + k + '" value="' + (values[k] || '') + '">';
          box.appendChild(l);
        });
      }

      const GUIDE_CATS = ['rail', 'eat', 'soak', 'konbini', 'ride'];

      function currentType() {
        return $('#form').dataset.type;
      }

      /** タブで「何を書く記事か」を切り替える。項目の出し入れと文言、検査が変わる */
      function setType(type, keepCategory) {
        const f = $('#form');
        f.dataset.type = type;
        document.querySelectorAll('.tab').forEach((b) =>
          b.setAttribute('aria-selected', String(b.dataset.type === type)),
        );

        const sel = f.elements['category'];
        [...sel.options].forEach((o) => {
          o.hidden = type === 'column' ? o.value !== 'column' : o.value === 'column';
        });
        if (!keepCategory) sel.value = type === 'column' ? 'column' : 'rail';

        const col = type === 'column';
        $('#lbl-checked').textContent = col ? '情報の確認日' : '料金確認日';
        $('#lg-facts').textContent = col
          ? '数値と出どころ　★載せる数字はすべてここに、出典つきで'
          : '事実データ　★本文に出る数値はここだけ';
        $('#hint-facts').textContent = col
          ? '数値は必ず出典とセット。一次情報（官公庁・企業IR・自治体）を証拠欄に書く。'
          : '金額は数字のみ（22000）。¥ や「円」を入れない。不確かな値は頭に ? を付ける。';
        $('#hint-sections').textContent = col
          ? '「根拠」が空のセクションは保存できない。コラムは一次体験ではなく出典で立つ記事なので。'
          : '「体験」か「実測」のどちらかが空だと保存できない。一般論で埋めさせないため。';
        $('#lg-sources').textContent = col ? '出典　★コラムは必須' : '出典（コラムは必須）';

        document.querySelectorAll('.lbl-exp').forEach((e) => (e.textContent = col ? '要点' : '体験（自分にしか書けないこと）'));
        document.querySelectorAll('.lbl-mea').forEach((e) => (e.textContent = col ? '根拠（どの出典にもとづくか）' : '実測（自分で測った事実）'));

        // コラムは常に researched。ガイドだけ選べる
        if (col) f.elements['basis'].value = 'researched';
        applyBasis();
        renderCatFields(sel.value);
      }

      /** basis によって、出す欄と検査の条件を切り替える */
      function applyBasis() {
        const f = $('#form');
        const researched = f.elements['basis'].value === 'researched';
        f.dataset.basis = researched ? 'researched' : 'visited';
        document.querySelectorAll('.visited-only').forEach((e) => (e.hidden = researched));
        document.querySelectorAll('.lbl-exp').forEach((e) => {
          if (f.dataset.type !== 'column') e.textContent = researched ? '要点' : '体験（自分にしか書けないこと）';
        });
        document.querySelectorAll('.lbl-mea').forEach((e) => {
          if (f.dataset.type !== 'column') {
            e.textContent = researched ? '根拠（どの出典にもとづくか）' : '実測（自分で測った事実）';
          }
        });
        const hint = $('#hint-sections');
        if (hint && f.dataset.type !== 'column') {
          hint.textContent = researched
            ? '「根拠」が空のセクションは保存できない。調べて書く記事は出典で立つので。'
            : '「体験」か「実測」のどちらかが空だと保存できない。一般論で埋めさせないため。';
        }
        const lg = $('#lg-sources');
        if (lg) lg.textContent = researched ? '出典　★2本以上が必須' : '出典（コラムは必須）';
      }

      function collect() {
        const f = $('#form');
        const g = (n) => (f.elements[n]?.value ?? '').trim();
        const facts = [...$('#facts').children].map((tr) => ({
          item: tr.querySelector('[name=f_item]').value.trim(),
          value: tr.querySelector('[name=f_value]').value.trim(),
          evidence: tr.querySelector('[name=f_evidence]').value.trim(),
        })).filter((r) => r.item || r.value);
        const sections = [...$('#sections').children].map((d) => ({
          heading: d.querySelector('[name=s_heading]').value.trim(),
          fare: d.querySelector('[name=s_fare]').value.trim(),
          time: d.querySelector('[name=s_time]').value.trim(),
          transfer: d.querySelector('[name=s_transfer]').value.trim(),
          walk: d.querySelector('[name=s_walk]').value.trim(),
          experience: d.querySelector('[name=s_experience]').value.trim(),
          measured: d.querySelector('[name=s_measured]').value.trim(),
          photos: d.querySelector('[name=s_photos]').value.trim(),
          memo: d.querySelector('[name=s_memo]').value.trim(),
        }));
        const faqs = [...$('#faqs').children].map((d) => ({
          q: d.querySelector('[name=faq_a]').value.trim(),
          a: d.querySelector('[name=faq_b]').value.trim(),
        })).filter((x) => x.q || x.a);
        const sources = [...$('#sources').children].map((d) => ({
          label: d.querySelector('[name=src_a]').value.trim(),
          url: d.querySelector('[name=src_b]').value.trim(),
        })).filter((x) => x.label || x.url);
        const cat = g('category');
        const catValues = {};
        (CAT_FIELDS[cat] || []).forEach(([k]) => (catValues[k] = (f.elements['c_' + k]?.value ?? '').trim()));

        return {
          locale: 'en',
          category: cat,
          slug: g('slug') || null,
          title: g('title'),
          status: g('status'),
          data: {
            basis: g('basis') || 'visited',
            meta: {
              areas: g('areas').split(',').map((s) => s.trim()).filter(Boolean),
              passes: g('passes').split(',').map((s) => s.trim()).filter(Boolean),
              visitedOn: g('visitedOn'), pricesCheckedOn: g('pricesCheckedOn'),
              mode: g('mode'), query: g('query'), revenue: g('revenue'),
              photosOwn: f.elements['photosOwn'].checked,
            },
            verdict: { buyIf: g('buyIf'), skipIf: g('skipIf'), total: g('total') },
            facts, category: catValues, sections, faqs, sources,
            photos: g('photos').split('\\n').map((s) => s.trim()).filter(Boolean),
            leftovers: g('leftovers'),
          },
        };
      }

      function validate(p) {
        const errs = [];
        if (!p.title) errs.push('仮タイトルが空です');
        if (!p.data.meta.pricesCheckedOn) errs.push('料金確認日が空です');
        p.data.facts.forEach((r, i) => {
          if (/[¥円$]/.test(r.value)) errs.push('事実データ ' + (i + 1) + ' 行目：金額は数字のみで入れてください');
          if (r.value && !r.evidence) errs.push('事実データ ' + (i + 1) + ' 行目：証拠が空です');
        });
        const col = p.category === 'column';
        const researched = col || p.data.basis === 'researched';
        p.data.sections.forEach((s, i) => {
          if (researched) {
            if (!s.measured) errs.push('セクション ' + (i + 1) + '：根拠（どの出典にもとづくか）を入れてください');
          } else if (!s.experience && !s.measured) {
            errs.push('セクション ' + (i + 1) + '：体験か実測のどちらかを入れてください');
          }
        });
        if (col && p.data.sources.length === 0) errs.push('コラムは出典が必須です');
        // 調べて書く記事は出典が根拠そのもの。1本では裏が取れない
        if (researched && p.data.sources.length < 2) {
          errs.push('調べて書く記事は出典が2本以上必要です（いま ' + p.data.sources.length + ' 本）');
        }
        if (!researched && !p.data.meta.visitedOn) errs.push('visited の記事は取材日が必要です');
        return errs;
      }

      function show(msg, bad) {
        const el = $('#msg');
        el.textContent = msg;
        el.hidden = !msg;
        el.className = 'msg' + (bad ? ' bad' : ' ok');
      }

      async function loadList() {
        const s = $('#filter-status').value;
        const r = await fetch(api + (s ? '?status=' + s : ''));
        if (!r.ok) return show('一覧を取得できません（' + r.status + '）', true);
        const { items } = await r.json();
        $('#list').innerHTML = items.map((i) =>
          '<li><button type="button" data-id="' + i.id + '"><span class="li-title">' + (i.title || '（無題）') +
          '</span><span class="li-meta">' + i.category + ' · ' + i.status + '</span></button>' +
          '<button type="button" class="li-copy" data-copy="' + i.id + '" title="この入稿の JSON をコピー">⧉</button></li>').join('');
        [...document.querySelectorAll('#list button[data-id]')].forEach((b) => (b.onclick = () => loadOne(b.dataset.id)));
        [...document.querySelectorAll('#list button[data-copy]')].forEach((b) => (b.onclick = async (e) => {
          e.stopPropagation();
          const r = await fetch(api + '/' + b.dataset.copy);
          if (!r.ok) return show('読み込めません', true);
          const text = JSON.stringify(await r.json(), null, 2);
          try {
            await navigator.clipboard.writeText(text);
            show('JSON をコピーしました（' + text.length.toLocaleString() + ' 文字）', false);
          } catch {
            $('#json-out').textContent = text;
            $('#json-out').hidden = false;
            show('コピーできませんでした。下の内容を選択してください', true);
          }
        }));
      }

      async function loadOne(id) {
        const r = await fetch(api + '/' + id);
        if (!r.ok) return show('読み込めません', true);
        const row = await r.json();
        const f = $('#form'), d = row.data || {};
        currentId = row.id;
        f.elements['category'].value = row.category;
        f.elements['status'].value = row.status;
        f.elements['slug'].value = row.slug || '';
        f.elements['title'].value = row.title || '';
        const m = d.meta || {};
        f.elements['areas'].value = (m.areas || []).join(', ');
        f.elements['passes'].value = (m.passes || []).join(', ');
        f.elements['basis'].value = d.basis || 'visited';
        f.elements['visitedOn'].value = m.visitedOn || '';
        f.elements['pricesCheckedOn'].value = m.pricesCheckedOn || '';
        f.elements['mode'].value = m.mode || '';
        f.elements['query'].value = m.query || '';
        f.elements['revenue'].value = m.revenue || '';
        f.elements['photosOwn'].checked = m.photosOwn !== false;
        const v = d.verdict || {};
        f.elements['buyIf'].value = v.buyIf || '';
        f.elements['skipIf'].value = v.skipIf || '';
        f.elements['total'].value = v.total || '';
        $('#facts').innerHTML = ''; (d.facts || []).forEach((x) => $('#facts').appendChild(rowFact(x)));
        $('#sections').innerHTML = ''; (d.sections || []).forEach((x) => $('#sections').appendChild(blockSection(x)));
        $('#faqs').innerHTML = ''; (d.faqs || []).forEach((x) => $('#faqs').appendChild(pair('faq', 'Q', 'A', x.q, x.a)));
        $('#sources').innerHTML = ''; (d.sources || []).forEach((x) => $('#sources').appendChild(pair('src', '名称', 'URL', x.label, x.url)));
        f.elements['photos'].value = (d.photos || []).join('\\n');
        f.elements['leftovers'].value = d.leftovers || '';
        setType(row.category === 'column' ? 'column' : 'guide', true);
        renderCatFields(row.category, d.category || {});
        show('読み込みました', false);
      }

      function reset() {
        currentId = null;
        $('#form').reset();
        $('#facts').innerHTML = ''; $('#sections').innerHTML = '';
        $('#faqs').innerHTML = ''; $('#sources').innerHTML = '';
        $('#facts').appendChild(rowFact()); $('#sections').appendChild(blockSection());
        setType(currentType() || 'guide');
        $('#json-out').hidden = true;
        show('', false);
      }

      document.addEventListener('click', (e) => {
        const add = e.target.dataset?.add;
        if (!add) return;
        if (add === 'fact') $('#facts').appendChild(rowFact());
        if (add === 'section') $('#sections').appendChild(blockSection());
        if (add === 'faq') $('#faqs').appendChild(pair('faq', 'Q', 'A'));
        if (add === 'source') $('#sources').appendChild(pair('src', '名称', 'URL', '', '', '公式サイト', 'https://'));
      });

      $('#form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const payload = collect();
        const errs = validate(payload);
        if (errs.length) return show(errs.join(' / '), true);
        const r = await fetch(currentId ? api + '/' + currentId : api, {
          method: currentId ? 'PUT' : 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!r.ok) return show('保存できません（' + r.status + '）', true);
        const out = await r.json();
        if (out.id) currentId = out.id;
        show('保存しました', false);
        loadList();
      });

      $('#json-btn').onclick = async () => {
        // 保存済みのものが選ばれていれば、画面の入力ではなく D1 の中身を渡す。
        // AI が読むのは GET /api/intake/:id なので、それと同じものを配る
        let text;
        if (currentId) {
          const r = await fetch(api + '/' + currentId);
          if (!r.ok) return show('読み込めません（' + r.status + '）', true);
          text = JSON.stringify(await r.json(), null, 2);
        } else {
          const draft = collect();
          if (!draft.title && draft.data.sections.every((x) => !x.heading && !x.experience && !x.measured)) {
            return show('まだ何も入っていません。左の一覧から入稿を選ぶか、先に保存してください', true);
          }
          show('未保存の入力をコピーします（保存してからのほうが確実です）', true);
          text = JSON.stringify({ id: null, ...draft }, null, 2);
        }
        const el = $('#json-out');
        el.hidden = true;
        try {
          // clipboard API は https かつユーザー操作が要る。満たせないときは下の退避へ
          await navigator.clipboard.writeText(text);
          show('JSON をコピーしました（' + text.length.toLocaleString() + ' 文字）', false);
          return;
        } catch {}
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          if (ok) {
            show('JSON をコピーしました', false);
            return;
          }
        } catch {}
        // どちらも駄目なら表示して手で選べるようにする
        el.textContent = text;
        el.hidden = false;
        show('コピーできませんでした。下の内容を選択してください', true);
      };
      $('#del-btn').onclick = async () => {
        if (!currentId || !confirm('この入稿を削除します')) return;
        await fetch(api + '/' + currentId, { method: 'DELETE' });
        reset(); loadList();
      };
      $('#new-btn').onclick = reset;
      document.querySelectorAll('.tab').forEach((b) => (b.onclick = () => { setType(b.dataset.type); }));
      $('#form').elements['basis'].addEventListener('change', applyBasis);
      $('#filter-status').onchange = loadList;
      $('#form').elements['category'].addEventListener('change', (e) => renderCatFields(e.target.value));

      setType('guide');
      reset();
      loadList();
    </script>

