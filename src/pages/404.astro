---
/**
 * 404。Cloudflare Pages は dist/404.html があるとき、存在しない URL にこれを 404 で返す。
 * 無いと SPA とみなされ、どの URL にもトップページを 200 で返してしまう
 * （検索エンジンには重複ページに見える）。
 *
 * IS_PUBLIC と無関係に恒久 noindex（docs/SPEC.md 第11節）。
 */
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { DEFAULT_LOCALE, NAV, ROUTES } from '../config.ts';
import { t, type UIKey } from '../i18n/ui.ts';
import { localePath } from '../i18n/index.ts';
import { strings } from '../i18n/pages/not-found.ts';

const lang = DEFAULT_LOCALE;
const s = strings(lang);
const nav = NAV.filter((n) => n.enabled);
---

<Base
  locale={lang}
  title={s.title}
  description={s.description}
  noindex
>
  <div class="wrap nf">
    <p class="kicker">404</p>
    <h1>{s.heading}</h1>
    <p class="dek">{s.dek}</p>
    <ul class="ways">
      <li>
        <a href={localePath(lang)}><Icon name="pin" /> {s.front}</a>
      </li>
      {
        nav.map((n) => (
          <li>
            <a href={localePath(lang, `/${n.key}/`)}>
              <Icon name={n.key} /> {t(lang, `nav.${n.key}` as UIKey)}
            </a>
          </li>
        ))
      }
      {
        ROUTES.foodPrices && (
          <li>
            <a href={localePath(lang, '/food-prices/')}>
              <Icon name="prices" /> {s.prices}
            </a>
          </li>
        )
      }
    </ul>
  </div>
</Base>

<style>
  .nf {
    max-width: 760px;
    padding-block: 56px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 44px;
    line-height: 1.1;
  }
  .dek {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .ways {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .ways li {
    border-bottom: 1px solid var(--line);
  }
  .ways a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .ways a:hover {
    color: var(--accent);
  }
  .ways :global(.icon) {
    color: var(--accent);
    font-size: 22px;
  }
  @media (max-width: 767px) {
    h1 {
      font-size: 32px;
    }
  }
</style>
