---
import Base from '../../layouts/Base.astro';
import Price from '../../components/Price.astro';
import RateNote from '../../components/RateNote.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, SITE_URL, type Locale } from '../../config.ts';
import {
  FOOD_PRICES,
  OFFICIAL_SOURCE,
  HESITATION_LINE,
  totalItems,
  filledItems,
  officialUpdatedAt,
  chainCheckedAt,
  chainItems,
  chainRange,
  type ChainItem,
  type ChainPrice,
} from '../../data/food-prices.ts';
import { formatPrice, formatJpy, formatAsOf } from '../../lib/money.ts';
import { dateTagOf, fill, fixedAlternates, localePath, escapeHtml } from '../../i18n/index.ts';
import { strings } from '../../i18n/pages/food-prices.ts';
import { localizeGroup } from '../../i18n/data/food-prices.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const s = strings(lang);
/** 分類・品目・チェーンの注記を、この言語にする（無い項目は英語。src/i18n/data/food-prices.ts） */
const groups = FOOD_PRICES.map((g) => localizeGroup(g, lang));

const monthLabel = (m: string) =>
  new Date(`${m}-01T00:00:00Z`).toLocaleDateString(dateTagOf(lang), { month: 'short', year: 'numeric', timeZone: 'UTC' });

/** チェーン価格は公式の税込表示のまま出す。コンビニは小数があるので丸めない */
const yen = (n: number) => (Number.isInteger(n) ? formatJpy(n) : `¥${n.toFixed(2)}`);
const chainPrice = (c: ChainPrice) => `${c.from ? s.from : ''}${yen(c.jpy)}${c.jpyMax ? `–${yen(c.jpyMax)}` : ''}`;
/** 価格欄に出す1行。平均は出さず、幅で見せる */
const chainLine = (item: ChainItem) => {
  const r = chainRange(item);
  if (!r) return null;
  const many = item.chains.filter((c) => c.tier !== 'premium').length > 1;
  // 名指しの1店は「Chain」と呼ばず、店名で出す
  const label = s.chainLine(item.tier, many, item.chains[0].chain);
  return `${label} ${r.from ? s.from : ''}${yen(r.min)}${r.max > r.min ? `–${yen(r.max)}` : ''}`;
};
const chainChecked = (item: ChainItem) => item.chains.map((c) => c.checkedOn).sort().at(-1)!.slice(0, 7);

const chipLabel = (item: ChainItem) => s.chainChip(item.tier);
/** 折りたたみの見出し。開く前に何社ぶんあるかが分かるようにする */
const chainCount = (item: ChainItem) => {
  if (item.tier === 'shop') return s.chainShop;
  const n = item.chains.length;
  return n === 1 ? s.chainOne(item.chains[0].chain) : s.chainMany(n);
};

/** 統計のある品目だけを安い順に並べ、ページ冒頭の目盛りにする */
const scale = groups.flatMap((g) => g.items)
  .filter((i) => i.official)
  .sort((a, b) => a.official!.jpy - b.official!.jpy);
const scaleMax = Math.max(...scale.map((i) => i.official!.jpy), HESITATION_LINE);

const graph = [
  {
    '@type': 'WebPage',
    name: s.title,
    description: s.graphDescription,
    url: new URL(localePath(lang, '/food-prices/'), SITE_URL).href,
  },
];
const legendVars = {
  source: escapeHtml(OFFICIAL_SOURCE.url),
  updated: escapeHtml(officialUpdatedAt),
  checked: escapeHtml(formatAsOf(chainCheckedAt, lang)),
};
---

<Base
  locale={lang}
  title={s.title}
  description={s.description}
  graph={graph}
  alternates={fixedAlternates('/food-prices/')}
>
  {/* 帯（全幅の背景・罫線）と列（1280）を分ける。一覧・記事と見出しの左端を揃える */}
  <div class="head">
    <div class="wrap head-inner">
      <p class="kicker">{s.kicker}</p>
      <h1>{s.title}</h1>
      <p class="dek">{s.dek}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap band-inner">
      <div class="line">
        <span class="line-label">{s.line.label}</span>
        <span class="line-value"><Price jpy={HESITATION_LINE} /></span>
        <span class="line-note">{s.line.note}</span>
      </div>

      <div class="scale">
        <span class="line-label">{s.line.scale}</span>
        <ul>
          {
            scale.map((i) => (
              <li>
                <span class="bar-name">{i.name}</span>
                <span class="bar" style={`width: ${Math.round((i.official!.jpy / scaleMax) * 100)}%`} />
                <span class="bar-value">{formatPrice(i.official!.jpy)}</span>
              </li>
            ))
          }
          <li class="limit">
            <span class="bar-name">{s.line.label}</span>
            <span class="bar line-bar" style={`width: ${Math.round((HESITATION_LINE / scaleMax) * 100)}%`}></span>
            <span class="bar-value">{formatPrice(HESITATION_LINE)}</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap body">
    <section class="legend">
      <h2>{s.legend.title}</h2>
      <div class="legend-grid">
        <div>
          <span class="chip official">{s.legend.survey}</span>
          <p set:html={fill(s.legend.surveyBody, legendVars)} />
        </div>
        <div>
          <span class="chip reference">{s.legend.local}</span>
          <p>{s.legend.localBody}</p>
        </div>
        <div>
          <span class="chip chain">{s.legend.chain}</span>
          <p set:html={fill(s.legend.chainBody, legendVars)} />
        </div>
        <div>
          <span class="chip tourist">{s.legend.both}</span>
          <p>{s.legend.bothBody}</p>
        </div>
        <div>
          <span class="chip tourist">{s.legend.tourist}</span>
          <p>{s.legend.touristBody}</p>
        </div>
      </div>
    </section>

    <nav class="jump" aria-label={s.jumpAria}>
      <span class="jump-label">{s.jumpLabel}</span>
      {groups.map((g) => <a href={`#${g.key}`}>{g.name}</a>)}
    </nav>

    {
      groups.map((group, gi) => (
        <details class="group" id={group.key} open={gi === 0}>
          <summary>
            <span class="g-name">
              {group.name} <span class="g-ja">{group.nameJa}</span>
            </span>
            <span class="g-count">
              {group.items.filter((i) => i.official || i.reference).length}/{group.items.length}
            </span>
          </summary>
          <div class="group-body">
            <p class="g-intro">{group.intro}</p>
            <table>
              <thead>
                <tr>
                  <th>{s.table.dish}</th>
                  <th>{s.table.everyday}</th>
                  <th>{s.table.tourist}</th>
                  <th>{s.table.basis}</th>
                </tr>
              </thead>
              <tbody>
                {group.items.map((i) => (
                  <>
                  <tr class:list={[{ empty: !i.official && !i.reference && !i.tourist && !i.noFixedPrice }]}>
                    <td>
                      <strong>{i.name}</strong>
                      <span class="ja">{i.nameJa}</span>
                    </td>
                    <td>
                      {i.official && i.reference ? (
                        <>
                          <span class="price-cell">
                            {i.reference.from && <span class="from">{s.from}</span>}
                            {formatPrice(i.reference.jpy)}
                          </span>
                          <span class="sub survey-sub">{s.surveySays} {formatPrice(i.official.jpy)}</span>
                        </>
                      ) : i.official ? (
                        <span class="price-cell">{formatPrice(i.official.jpy)}</span>
                      ) : i.reference ? (
                        <span class="price-cell">
                          {i.reference.from && <span class="from">{s.from}</span>}
                          {formatPrice(i.reference.jpy)}
                        </span>
                      ) : i.noFixedPrice ? (
                        <span class="nofix">{s.noFixedPrice}</span>
                      ) : (
                        <span class="todo">{s.notSet}</span>
                      )}
                      {i.chain && chainLine(i.chain) && <span class="sub chain-sub">{chainLine(i.chain)}</span>}
                    </td>
                    <td>
                      {i.tourist ? (
                        <>
                          <span class="price-cell">
                            {i.tourist.from && <span class="from">{s.from}</span>}
                            {formatPrice(i.tourist.jpy)}
                          </span>
                          <span class="sub">{i.tourist.note}</span>
                        </>
                      ) : (
                        <span class="sub">—</span>
                      )}
                    </td>
                    <td>
                      {i.official && i.reference && (
                        <>
                          <span class="chip reference">{s.chips.local}</span>
                          <span class="sub">
                            {i.reference.note} · {monthLabel(i.reference.seenOn)}
                          </span>
                          <span class="chip official">{s.chips.survey}</span>
                          <span class="sub">
                            {i.official.definition} · {monthLabel(i.official.month)}
                            {i.official.area && <> · {i.official.area}</>}
                          </span>
                        </>
                      )}
                      {i.official && !i.reference && (
                        <>
                          <span class="chip official">{s.chips.survey}</span>
                          <span class="sub">
                            {i.official.definition} · {monthLabel(i.official.month)}
                            {i.official.area && <> · {i.official.area}</>}
                          </span>
                        </>
                      )}
                      {!i.official && i.reference && (
                        <>
                          <span class="chip reference">{s.chips.local}</span>
                          <span class="sub">
                            {i.reference.note} · {monthLabel(i.reference.seenOn)}
                          </span>
                        </>
                      )}
                      {i.chain && (
                        <>
                          <span class="chip chain">{chipLabel(i.chain)}</span>
                          <span class="sub">
                            {i.chain.what} · {monthLabel(chainChecked(i.chain))}
                          </span>
                          <details class="chain-more">
                          <summary>{chainCount(i.chain)} <Icon name="chevron" /></summary>
                          <ul class="chain-list">
                            {i.chain.chains
                              .filter((c) => c.tier !== 'premium')
                              .map((c) => (
                                <li>
                                  <a href={c.url} rel="noopener nofollow">{c.chain}</a> {chainPrice(c)}
                                  {c.note && <span class="chain-note"> — {c.note}</span>}
                                </li>
                              ))}
                          </ul>
                          {i.chain.note && <span class="sub">{i.chain.note}</span>}
                          {i.chain.chains.some((c) => c.tier === 'premium') && (
                            <>
                              <span class="chip premium">{s.chips.premium}</span>
                              <ul class="chain-list">
                                {i.chain.chains
                                  .filter((c) => c.tier === 'premium')
                                  .map((c) => (
                                    <li>
                                      <a href={c.url} rel="noopener nofollow">{c.chain}</a> {chainPrice(c)}
                                      {c.note && <span class="chain-note"> — {c.note}</span>}
                                    </li>
                                  ))}
                              </ul>
                            </>
                          )}
                          </details>
                        </>
                      )}
                      {i.noFixedPrice && (
                        <>
                          <span class="chip nofix-chip">{s.noNumber}</span>
                          <span class="sub">{i.noFixedPrice.why}</span>
                          <span class="sub todo-do">{i.noFixedPrice.whatToDo}</span>
                        </>
                      )}
                      {!i.official && !i.reference && !i.noFixedPrice && <span class="sub">—</span>}
                    </td>
                  </tr>
                  {i.context && (
                    <tr class="context-row">
                      <td colspan="4">{i.context}</td>
                    </tr>
                  )}
                </>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      ))
    }

    <section class="fill">
      <h2>{s.fillTitle}</h2>
      {/* 原文に ' があり、式で出すと &#39; に変わる。英語の出力を変えないため set:html（リポジトリ内の固定文のみ） */}
      <p set:html={s.fillBody(filledItems, totalItems, chainItems, formatAsOf(chainCheckedAt, lang))} />
    </section>

    <RateNote locale={lang} />
  </div>
</Base>

<script>
  // 目次から飛んだ先の分類が閉じていたら開く（details は # で飛んでも自動では開かない）
  const openTarget = () => {
    const el = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  };
  addEventListener('hashchange', openTarget);
  if (location.hash) openTarget();
</script>

<style>
  .head {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .head-inner {
    padding-block: 30px 24px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 44px;
    line-height: 1.1;
  }
  .dek {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 760px;
  }

  .band {
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .band-inner {
    display: flex;
    gap: 40px;
    padding-block: 24px 28px;
    align-items: flex-start;
  }
  .line {
    flex: 0 0 300px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .line-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .line-value {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
  }
  .line-note {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .scale {
    flex: 1 1 auto;
    min-width: 0;
  }
  .scale ul {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .scale li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
  }
  .bar-name {
    flex: 0 0 140px;
    text-align: right;
    color: var(--ink-2);
  }
  .bar {
    height: 14px;
    background: var(--accent);
    min-width: 2px;
  }
  .limit .bar-name,
  .limit .bar-value {
    color: var(--accent);
    font-weight: 600;
  }
  .line-bar {
    background: repeating-linear-gradient(
      90deg,
      var(--accent) 0 6px,
      transparent 6px 10px
    );
  }
  .bar-value {
    white-space: nowrap;
    color: var(--muted-2);
  }

  /* .wrap（1280・中央）の中で、中身だけ 1000 に抑えて左に寄せる。見出しの左端が他ページと揃う */
  .body {
    padding-block: 30px 0;
  }
  .body > * {
    max-width: 1000px;
  }

  .legend {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 20px 22px;
    margin-bottom: 26px;
  }
  .legend h2 {
    font-size: 19px;
    margin-bottom: 14px;
  }
  .legend-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .legend p {
    margin: 7px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .chip {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 8px;
    border: 1px solid var(--line);
  }
  .chip.official {
    color: var(--confirm);
    border-color: var(--confirm-line);
    background: var(--confirm-bg);
  }
  .chip.reference {
    color: var(--accent);
    border-color: #e0c7b5;
    background: var(--caution-bg);
  }
  .chip.tourist {
    color: var(--muted-2);
    background: var(--surface-2);
  }
  .chip.chain,
  .chip.premium {
    color: var(--ink-2);
    background: var(--surface);
    border-color: var(--ink-2);
  }
  td .chip:not(:first-child) {
    margin-top: 9px;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    align-items: center;
    margin-bottom: 22px;
  }
  .jump-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 4px;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 4px 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-2);
  }
  .jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .group {
    scroll-margin-top: 12px;
  }
  /* チェーンの内訳は畳んでおく。価格欄に幅が出ているので、店ごとの額は見たい人だけが開く */
  /* 分類の見出し（.group summary）の指定が中の summary にも届くので、ここで打ち消す */
  .group .chain-more summary {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
    min-height: 32px;
    padding: 0;
    font-size: 13px;
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }
  .group .chain-more summary::before {
    content: none;
  }
  .chain-more summary::-webkit-details-marker {
    display: none;
  }
  .chain-more[open] summary :global(.icon) {
    transform: rotate(180deg);
  }
  .chain-list {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .chain-list a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 2px;
  }
  .chain-note {
    color: var(--muted);
  }

  /* 大項目のトグル。JS を使わず details で開閉する */
  .group {
    border: 1px solid var(--line);
    background: var(--surface);
    margin-bottom: 12px;
  }
  .group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 15px 20px;
    cursor: pointer;
    min-height: 44px;
    list-style: none;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .group summary::before {
    content: '+';
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--accent);
    width: 16px;
    flex-shrink: 0;
  }
  .group[open] summary::before {
    content: '–';
  }
  .g-name {
    flex: 1 1 auto;
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 600;
  }
  .g-ja {
    font-family: var(--font-jp);
    font-size: 14px;
    color: var(--muted);
    margin-left: 8px;
  }
  .g-count {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .group-body {
    border-top: 1px solid var(--line);
    padding: 16px 20px 20px;
  }
  .g-intro {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  thead th {
    text-align: left;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 2px solid var(--ink);
    padding: 0 10px 8px 0;
  }
  td {
    border-bottom: 1px solid var(--line-2);
    padding: 11px 10px 11px 0;
    vertical-align: top;
  }
  tr.empty td {
    color: var(--muted);
  }
  .ja {
    display: block;
    font-family: var(--font-jp);
    font-size: 13px;
    color: var(--muted);
  }
  .price-cell {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    white-space: nowrap;
  }
  .sub {
    display: block;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin-top: 3px;
  }
  .nofix {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .chip.nofix-chip {
    color: var(--accent);
    border-color: #e0c7b5;
    background: var(--caution-bg);
  }
  .todo-do {
    color: var(--ink-2);
    margin-top: 5px;
  }
  .from {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }
  /* 背景説明。行の下に全幅で置く。表のセル幅では読めないため */
  .context-row td {
    border-bottom: 1px solid var(--line);
    padding: 0 0 13px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--ink-2);
    background: var(--surface-2);
    padding-inline: 14px;
    padding-top: 11px;
  }
  .survey-sub {
    color: var(--muted);
    font-style: italic;
  }
  .todo {
    font-size: 13px;
    color: var(--muted);
    font-style: italic;
  }

  .fill {
    margin: 24px 0;
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    padding: 18px 20px;
  }
  .fill h2 {
    font-size: 19px;
    margin-bottom: 8px;
  }
  .fill p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    h1 {
      font-size: 30px;
    }
