---
/**
 * プライバシーポリシー。
 *
 * 記述は「現時点の実態」に合わせる。やっていないことを書かない、やっていることは必ず書く。
 *
 * 現在の実態（2026-10-29）:
 *   - Google アナリティクス4（Cookie あり。同意するまで保存も送信もしない：Analytics.astro / ConsentBanner.astro）
 *   - Cloudflare Pages での配信（通信記録）
 *   - 問い合わせは fam16.com のフォーム（この運営者の別サイト）。このサイトにはフォームもメール登録も無い
 *   - アフィリエイトは AFFILIATE のフラグが立つまで無い（立てたら下の該当節が表示される）
 *   - 地図・動画などの外部埋め込みは無い
 *
 * GA4 の記述は GA4_MEASUREMENT_ID の有無に、アフィリエイトの記述は hasAnyAffiliate に連動する。
 * ⚠ 解析ツール・フォーム・埋め込み・アフィリエイトを変えたら、同じコミットで本ページと PRIVACY_UPDATED を更新する。
 *
 * 文言は src/i18n/pages/privacy.ts（言語ごとの表）。条件分岐はここに残す。
 * 法的な内容なので、翻訳は人の確認が要る（privacy.ts の先頭に注記）。
 */
import Base from '../../layouts/Base.astro';
import { LOCALES, OPERATOR, GA4_MEASUREMENT_ID, PRIVACY_UPDATED, hasAnyAffiliate, type Locale } from '../../config.ts';
import { fill, fixedAlternates, escapeHtml } from '../../i18n/index.ts';
import { strings } from '../../i18n/pages/privacy.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const s = strings(lang);
const ga4 = GA4_MEASUREMENT_ID !== '';
/** 文中のリンク先。言語で変わらない外部 URL と、フォームの URL */
const vars = Object.fromEntries(
  Object.entries({
    contact: OPERATOR.contactUrl,
    cookieId: GA4_MEASUREMENT_ID.replace('G-', ''),
    optout: 'https://tools.google.com/dlpage/gaoptout',
    partnerSites: 'https://policies.google.com/technologies/partner-sites',
  }).map(([k, v]) => [k, escapeHtml(v)]),
);
---

<Base
  locale={lang}
  title={s.title}
  description={s.description}
  alternates={fixedAlternates('/privacy/')}
>
  <section class="wrap legal">
    <p class="kicker">{s.kicker}</p>
    <h1>{s.h1}</h1>
    <p class="updated">{s.updated} {PRIVACY_UPDATED}</p>

    <div class="prose">
      <p>{s.intro(OPERATOR.name)}</p>

      <h2>{s.s1.title}</h2>
      <dl class="info">
        <dt>{s.s1.operator}</dt><dd>{OPERATOR.name}</dd>
        <dt>{s.s1.representative}</dt><dd>{OPERATOR.representative}</dd>
        <dt>{s.s1.address}</dt><dd>{s.s1.addressLine(OPERATOR.address)}</dd>
        <dt>{s.s1.contact}</dt><dd><a href={OPERATOR.contactUrl}>{s.s1.contactLink}</a></dd>
      </dl>

      <h2>{s.s2.title}</h2>
      <p>{s.s2.none}</p>
      <ul>
        {ga4 && <li set:html={s.s2.analytics} />}
        <li set:html={s.s2.hosting} />
        <li set:html={s.s2.messages} />
        <li set:html={s.s2.choice} />
      </ul>
      {hasAnyAffiliate && <p>{s.s2.affiliate}</p>}
      <p>{s.s2.embeds}</p>

      <h2>{s.s3.title}</h2>
      {ga4 ? (
        <>
          <p set:html={fill(s.s3.consent, vars)} />
          <p set:html={fill(s.s3.names, vars)} />
          <p set:html={fill(s.s3.change, vars)} />
        </>
      ) : (
        <p>{s.s3.none}</p>
      )}

      <h2>{s.s4.title}</h2>
      <ul>
        {ga4 && <li>{s.s4.analytics}</li>}
        <li>{s.s4.hosting}</li>
        <li>{s.s4.messages}</li>
      </ul>
      <p>{s.s4.closing}</p>

      <h2>{s.s5.title}</h2>
      <p>{s.s5.body(ga4 ? s.s5.providersGa4 : s.s5.providersNoGa4)}</p>
      <p>{s.s5.noShare}</p>

      <h2>{s.s6.title}</h2>
      <p>
        {(ga4 ? s.s6.analytics : '') + s.s6.rest}
      </p>

      <h2>{s.s7.title}</h2>
      <p>{s.s7.p1}</p>
      <p set:html={fill(s.s7.p2, vars)} />

      <h2>{s.s8.title}</h2>
      <p>{s.s8.body}</p>

      <h2>{s.s9.title}</h2>
      <p>{s.s9.body}</p>

      <h2>{s.history.title}</h2>
      <ul>
        <li>{s.history.first(PRIVACY_UPDATED)}</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-block: 56px 24px;
  }
  .kicker {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .legal h1 {
    margin: 0 0 8px;
  }
  .updated {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 15px;
  }
  .legal :global(.prose h2) {
    margin-top: 40px;
  }
  .info {
    display: grid;
    grid-template-columns: 8em minmax(0, 1fr);
    gap: 8px 20px;
    margin: 0 0 16px;
    padding: 18px 20px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    font-size: 17px;
  }
  .info dt {
    color: var(--muted);
  }
  .info dd {
    margin: 0;
  }
  @media (max-width: 520px) {
    .info {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px 0;
    }
    .info dd + dt {
      margin-top: 10px;
    }
  }
</style>
