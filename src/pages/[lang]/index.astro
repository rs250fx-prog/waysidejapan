---
import Base from '../../layouts/Base.astro';
import Price from '../../components/Price.astro';
import { LOCALES, SITE_NAME, TAGLINE, NAV, type Locale } from '../../config.ts';
import { listArticles, hrefOf } from '../../lib/content.ts';
import { t, type UIKey } from '../../i18n/ui.ts';
import { formatMonth } from '../../lib/money.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const articles = await listArticles(lang);
const featured = articles[0];
const latest = articles.slice(1, 7);
const categories = NAV.filter((n) => n.enabled);
---

<Base
  locale={lang}
  bareTitle
  title={`${SITE_NAME} — western Japan by train, plate and bath`}
  description="A Japanese local writing in English about western Japan by rail: regional passes, the food along the line, and onsen within walking distance of a platform. Own photographs, fares with a date."
>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="kicker">{t(lang, 'home.start')}</p>
      {
        featured ? (
          <>
            <h1>{featured.data.title}</h1>
            <p class="dek">{featured.data.description}</p>
            <p class="meta">
              {featured.data.experience && <>Rode this route {featured.data.experience.visitedOn} · </>}
              <span class="badge-verified">
                {t(lang, 'article.verified')} {formatMonth(featured.data.pricesCheckedOn)}
              </span>
            </p>
            <a class="btn" href={hrefOf(featured)}>Read the guide</a>
          </>
        ) : (
          <>
            <h1>{SITE_NAME}</h1>
            <p class="dek">{TAGLINE} — western Japan by train, plate and bath. The first guides are being written.</p>
          </>
        )
      }
    </div>
    <div class="hero-photo" aria-hidden="true"></div>
  </section>

  <section class="strip">
    <div class="wrap strip-inner">
      <div>
        <h2 class="strip-title">Photographed myself</h2>
        <p>No stock images. Every photo is one I took, on the day stated.</p>
      </div>
      <div>
        <h2 class="strip-title">Fares with a date</h2>
        <p>Every price says when it was last checked, and gets rechecked.</p>
      </div>
      <div>
        <h2 class="strip-title">Yen, converted</h2>
        <p>Shown as <Price jpy={1200} />, updated daily.</p>
      </div>
    </div>
  </section>

  <section class="wrap block">
    <h2 class="section-title">Three ways in</h2>
    <div class="cards grid">
      {
        categories.map((c) => (
          <a class="card" href={`/${lang}/${c.key}/`}>
            <span class="card-photo" aria-hidden="true" />
            <span class="card-title">{t(lang, `nav.${c.key}` as UIKey)}</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="wrap block">
        <h2 class="section-title">{t(lang, 'home.latest')}</h2>
        <div class="list grid">
          {latest.map((a) => (
            <a class="row" href={hrefOf(a)}>
              <span class="row-photo" aria-hidden="true" />
              <span class="row-text">
                <span class="row-cat">{t(lang, `nav.${a.data.category}` as UIKey)}</span>
                <span class="row-title">{a.data.title}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: flex;
    gap: 40px;
    align-items: center;
    padding-block: 44px;
  }
  .hero-text {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .hero-photo {
    flex: 0 0 520px;
    height: 400px;
    background: #efe6d6;
    border: 1px solid #ded3bf;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 44px;
    line-height: 1.1;
  }
  .dek {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .meta {
    margin: 0;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }

  .strip {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .strip-inner {
    display: flex;
    gap: 40px;
    padding-block: 22px;
  }
  .strip-inner > div {
    flex: 1 1 0;
    min-width: 0;
  }
  .strip-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 5px;
  }
  .strip p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .block {
    padding-block: 34px 0;
  }
  .section-title {
    font-size: 26px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    border-top: 3px solid var(--accent);
    padding-top: 14px;
  }
  .card-photo {
    height: 150px;
    background: #efe6d6;
    border: 1px solid #ded3bf;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 24px;
  }
  .row {
    display: flex;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
  }
  .row-photo {
    flex: 0 0 104px;
    height: 78px;
    background: #efe6d6;
    border: 1px solid #ded3bf;
  }
  .row-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .row-cat {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .row-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .hero,
    .strip-inner {
      flex-direction: column;
      gap: 24px;
    }
    .hero-photo {
      flex: none;
      width: 100%;
      height: 240px;
    }
    .cards,
    .list {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
