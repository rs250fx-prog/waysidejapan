---
import Base from '../../layouts/Base.astro';
import Price from '../../components/Price.astro';
import Icon from '../../components/Icon.astro';
import { LOCALES, SITE_NAME, TAGLINE, NAV, type Locale } from '../../config.ts';
import { listArticles, hrefOf } from '../../lib/content.ts';
import { t, type UIKey } from '../../i18n/ui.ts';
import { formatMonth } from '../../lib/money.ts';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { IMAGE_SPEC } from '../../lib/images.ts';
import Thumb from '../../components/Thumb.astro';
/* トップの絵はイラスト。写真ではないので「Photographed myself」の約束とは別扱い */
import eatArt from '../../assets/home/way-eat.webp';
import soakArt from '../../assets/home/way-soak.webp';
import railArt from '../../assets/home/way-rail.webp';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const articles = await listArticles(lang);
const featured = articles[0];
const latest = articles.filter((a) => a.data.category !== 'column').slice(1, 7);
const columns = await listArticles(lang, 'column');

/** 「Three ways in」は旅の3カテゴリ固定。コラムは別枠で扱う */
const PRIMARY = ['eat', 'soak', 'rail'] as const;
const categories = NAV.filter((n) => n.enabled && (PRIMARY as readonly string[]).includes(n.key));
/** カードの1行説明。写真が入るまでは、これとアイコンが入口の手がかりになる */
const WAYS: Record<string, string> = {
  eat: 'What each dish is, why it is the way it is, what locals pay for it, and where its lineages come from.',
  soak: 'Onsen you can walk to from a platform, with the rules stated up front.',
  rail: 'Getting there: regional passes, model routes, and the transfers that catch people out.',
};
const WAY_ART: Record<string, { src: ImageMetadata; alt: string }> = {
  eat: { src: eatArt, alt: 'Illustration of a bowl of soba with tempura and green onion, beside a plate of yakitori skewers' },
  soak: { src: soakArt, alt: 'Illustration of a small stone outdoor onsen with a wooden bucket, a local train waiting at the platform behind' },
  rail: { src: railArt, alt: 'Illustration of a two-car local train crossing a bridge over rice paddies, with a rail pass in the corner' },
};
const cardSpec = IMAGE_SPEC.card;
---

<Base
  locale={lang}
  bareTitle
  title={`${SITE_NAME} — what Japan eats, and why`}
  description="A Japanese local explaining what Japan eats and why: the price locals pay, the lineages behind each dish, and the trains and baths on the way."
>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="kicker">{t(lang, 'home.start')}</p>
      {
        featured ? (
          <>
            <h1>{featured.data.title}</h1>
            <p class="dek">{featured.data.description}</p>
            <p class="meta">
              {featured.data.experience && <>Rode this route {featured.data.experience.visitedOn} · </>}
              <span class="badge-verified">
                <Icon name="verified" /> {t(lang, 'article.verified')} {formatMonth(featured.data.pricesCheckedOn)}
              </span>
            </p>
            <a class="btn" href={hrefOf(featured)}>Read the guide <Icon name="arrow" /></a>
          </>
        ) : (
          <>
            <h1>{SITE_NAME}</h1>
            <p class="dek">{TAGLINE} — what Japan eats, and why. The first guides are being written.</p>
          </>
        )
      }
    </div>
    {
      /* 先頭記事のヒーロー。見出しの「Read the guide」と同じ行き先なので、
         読み上げとタブ移動からは外す（同じリンクを二度言わせない） */
      featured && (
        <a class="hero-photo" href={hrefOf(featured)} aria-hidden="true" tabindex="-1">
          <Thumb entry={featured} kind="hero" />
        </a>
      )
    }
  </section>

  <section class="strip">
    <div class="wrap strip-inner">
      <div>
        <p class="strip-title"><Icon name="camera" /> Photographed myself</p>
        <p>No stock images. Every photo is one I took, on the day stated.</p>
      </div>
      <div>
        <p class="strip-title"><Icon name="verified" /> Fares with a date</p>
        <p>Every price says when it was last checked, and gets rechecked.</p>
      </div>
      <div>
        <p class="strip-title"><Icon name="prices" /> Yen, converted</p>
        <p>Shown as <Price jpy={1200} />, updated daily.</p>
      </div>
    </div>
  </section>

  {
    columns.length > 0 && (
      <section class="column-band">
        <div class="wrap">
          <div class="cb-head">
            <div>
              <p class="kicker">Column</p>
              <h2 class="cb-title">What a guidebook will not tell you</h2>
              <p class="cb-dek">
                The places locals quietly avoid, the everyday knowledge most Japanese people never had to learn, and
                the reasons behind both. Researched and sourced rather than photographed.
              </p>
            </div>
            <a class="cb-all" href={`/${lang}/column/`}>
              All columns <Icon name="arrow" />
            </a>
          </div>

          <div class="cb-grid">
            <a class="cb-lead" href={hrefOf(columns[0])}>
              <span class="cb-lead-kicker">Latest column</span>
              <span class="cb-lead-title">{columns[0].data.title}</span>
              <span class="cb-lead-dek">{columns[0].data.description}</span>
              <span class="cb-read">Read the column <Icon name="arrow" /></span>
            </a>

            <div class="cb-more">
              {columns.slice(1, 4).map((a) => (
                <a class="cb-item" href={hrefOf(a)}>
                  <span class="cb-item-title">{a.data.title}</span>
                  <span class="cb-item-meta">
                    {a.data.sources.length > 0 ? `${a.data.sources.length} sources` : 'Researched'}
                  </span>
                </a>
              ))}
              {columns.length === 1 && (
                <p class="cb-empty">More columns are being written. They take longer than the guides — every figure in
                one has to come from a source I can name.</p>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="wrap block">
    <h2 class="section-title">Three ways in</h2>
    <div class="cards grid">
      {
        categories.map((c) => (
          <a class="card" href={`/${lang}/${c.key}/`}>
            <span class="card-photo ph ratio-card">
              {WAY_ART[c.key] && (
                <Image
                  src={WAY_ART[c.key].src}
                  alt={WAY_ART[c.key].alt}
                  width={cardSpec.widths.at(-1)}
                  widths={cardSpec.widths}
                  sizes={cardSpec.sizes}
                  loading={cardSpec.loading}
                />
              )}
              <span class="card-label">
                <Icon name={c.key} />
                <span class="card-title">{t(lang, `nav.${c.key}` as UIKey)}</span>
              </span>
            </span>
            <span class="card-dek">{WAYS[c.key]}</span>
            <span class="card-go">Browse <Icon name="arrow" /></span>
          </a>
        ))
      }
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="wrap block">
        <h2 class="section-title">{t(lang, 'home.latest')}</h2>
        <div class="list grid">
          {latest.map((a) => (
            <a class="row" href={hrefOf(a)}>
              <Thumb entry={a} kind="thumb" class="row-photo" />
              <span class="row-text">
                <span class="row-cat">{t(lang, `nav.${a.data.category}` as UIKey)}</span>
                <span class="row-title">{a.data.title}</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: flex;
    gap: 40px;
    align-items: center;
    padding-block: 44px;
  }
  .hero-text {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
  }
  .hero-photo {
    flex: 0 0 min(520px, 45%);
  }
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 44px;
    line-height: 1.1;
  }
  .dek {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .meta {
    margin: 0;
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--muted);
  }

  .strip {
    background: var(--surface-2);
    border-block: 1px solid var(--line);
  }
  .strip-inner {
    display: flex;
    gap: 40px;
    padding-block: 22px;
  }
  .strip-inner > div {
    flex: 1 1 0;
    min-width: 0;
  }
  .strip p.strip-title {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 5px;
  }
  .strip p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .block {
    padding-block: 34px 0;
  }
  .section-title {
    font-size: 26px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 16px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    border-top: 3px solid var(--accent);
    padding-top: 14px;
  }

  /* 名前は絵の左上に札で載せる。絵の線が多い位置でも読めるよう地色を敷く */
  .card-photo {
    position: relative;
  }
  .card-label {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px 7px 10px;
    background: var(--accent);
    color: #fff;
    font-size: 18px;
    line-height: 1;
    box-shadow: 0 1px 3px rgba(60, 40, 20, 0.25);
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .card-dek {
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .card-go {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .btn :global(.icon) {
    margin-left: 8px;
  }

  .head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .more {
    font-size: 15px;
    text-decoration: none;
  }

  /* コラムは全幅の帯で扱う。ガイド記事の流れを一度止めて、
     「このサイトは調べて書く面も持つ」と示す位置 */
  .column-band {
    margin-top: 40px;
    background: var(--surface-2);
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid var(--line);
    padding-block: 32px 36px;
  }
  .cb-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 16px;
    margin-bottom: 22px;
  }
  .cb-title {
    font-size: 34px;
    line-height: 1.12;
    margin-top: 4px;
  }
  .cb-dek {
    margin: 8px 0 0;
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
    max-width: 680px;
  }
  .cb-all {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .cb-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 32px;
  }
  .cb-lead {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
    color: inherit;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    padding: 26px 30px;
  }
  .cb-lead-kicker {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cb-lead-title {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.012em;
  }
  .cb-lead-dek {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .cb-read {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
  }
  .cb-more {
    display: flex;
    flex-direction: column;
  }
  .cb-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--line);
    padding: 14px 0;
  }
  .cb-item:first-child {
    padding-top: 0;
  }
  .cb-item-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }
  .cb-item-meta {
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cb-empty {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted-2);
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px 24px;
  }
  .row {
    display: flex;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
  }
  .row :global(.row-photo) {
    flex: 0 0 120px;
    align-self: flex-start;
  }
  .row-text {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .row-cat {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .row-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 900px) {
    .hero,
    .strip-inner {
      flex-direction: column;
      gap: 24px;
    }
    .hero-photo {
      flex: none;
      width: 100%;
    }
    .cards,
    .list {
      grid-template-columns: 1fr;
    }
    .cb-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .cb-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }
    .cb-title {
      font-size: 26px;
    }
    .cb-lead {
      padding: 20px 22px;
    }
    .cb-lead-title {
      font-size: 24px;
    }
    h1 {
      font-size: 32px;
    }
  }
</style>
