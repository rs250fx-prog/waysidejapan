---
import { render } from 'astro:content';
import Article from '../../../layouts/Article.astro';
import { allRoutable, alternatesFor } from '../../../lib/content.ts';
import { parseId } from '../../../content.config.ts';
import type { Locale } from '../../../config.ts';

export async function getStaticPaths() {
  const entries = await allRoutable();
  return entries.map((entry) => {
    const { locale, category, slug } = parseId(entry.id);
    return { params: { lang: locale, category, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;

// 実在し、検索に出す他言語版だけ hreflang に出す（自己参照つき。noindex の版は出さない）
const alternates = await alternatesFor(entry);

const { Content } = await render(entry);
---

<Article entry={entry} locale={lang} alternates={alternates}>
  <Content />
</Article>
