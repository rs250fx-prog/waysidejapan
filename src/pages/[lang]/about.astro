---
import Base from '../../layouts/Base.astro';
import { LOCALES, SITE_NAME, AUTHOR, OPERATOR, SITE_URL, hasAnyAffiliate, ROUTES, type Locale } from '../../config.ts';
import { REGIONS } from '../../data/regions.ts';
import { localePath, fixedAlternates } from '../../i18n/index.ts';
import { strings } from '../../i18n/pages/about.ts';
import { regionName, regionNote } from '../../i18n/data/regions.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
const s = strings(lang);

/**
 * 記事のバイラインから毎回ここへ飛ばす。E-E-A-T の受け皿なので、
 * 主張する数値（走行距離・ローカルガイドのレベル）は事実でなくなったら直す。
 * 文言は src/i18n/pages/about.ts。
 */
const credentials = s.credentials;

const graph = [
  {
    '@type': 'ProfilePage',
    mainEntity: { '@id': `${SITE_URL}/#author` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE_URL}/#publisher`,
    name: OPERATOR.name,
    url: 'https://fam16.com/',
    address: {
      '@type': 'PostalAddress',
      streetAddress: OPERATOR.address,
      postalCode: OPERATOR.postalCode,
      addressCountry: 'JP',
    },
  },
];
---

<Base
  locale={lang}
  title={s.title}
  description={s.description}
  graph={graph}
  alternates={fixedAlternates('/about/')}
>
  {/* 帯（全幅の背景・罫線）と列（1280）を分ける。肖像と見出しは列の中に置き、他ページと左端を揃える */}
  <section class="hero">
    <div class="wrap hero-inner">
    <div class="portrait ph ratio-portrait" aria-hidden="true">{s.portrait}</div>
    <div class="intro">
      <p class="kicker">{s.kicker}</p>
      <h1>{s.h1}</h1>
      <p class="lead">{s.lead1(AUTHOR.nameJa)}</p>
      <p class="lead">{s.lead2}</p>
    </div>
    </div>
  </section>

  {/* SP だけの実績の帯。PC では右カラムに同じ数字を出す */}
  <section class="credentials">
    <div class="wrap cred-inner">
      {
        credentials.map((c) => (
          <div>
            <div class="cred-value">{c.value}</div>
            <div class="cred-label">{c.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  {/* 本文 880 ＋ 右カラム 280。記事ページと同じ骨格（docs/HUB-DESIGN.md 実行C） */}
  <div class="wrap about-layout">
  <div class="body">
    <section id="why">
      <h2>{s.why.title}</h2>
      <p>{s.why.p1}</p>
      <p>{s.why.p2}</p>
    </section>

    <section id="travel">
      <h2>{s.travel.title}</h2>
      <p>{s.travel.p1}</p>
      <p>{s.travel.p2}</p>
      <p>{s.travel.p3}</p>
    </section>

    <section id="work">
      <h2>{s.work.title}</h2>
      <div class="principles">
        <div>
          <h3>{s.work.kinds.title}</h3>
          <p set:html={s.work.kinds.body} />
        </div>
        <div>
          <h3>{s.work.dates.title}</h3>
          <p>{s.work.dates.body}</p>
        </div>
        <div>
          <h3>{s.work.yen.title}</h3>
          <p>{s.work.yen.body}</p>
        </div>
        <div>
          <h3>{s.work.photos.title}</h3>
          <p>{s.work.photos.body}</p>
        </div>
      </div>
    </section>

    {
      /* 収益化していないあいだは、この節ごと出さない。
         提携が通って AFFILIATE が true になったら自動で現れる */
      hasAnyAffiliate && (
        <section class="money" id="money">
          <h2>{s.money.title}</h2>
          <p>{s.money.p1}</p>
          <p>{s.money.p2}</p>
          {ROUTES.disclosure && (
            <p>
              <a href={localePath(lang, '/disclosure/')}>{s.money.disclosure}</a>
            </p>
          )}
        </section>
      )
    }

    <section id="regions">
      <h2>{s.regions.title}</h2>
      <p>{s.regions.intro}</p>
      <ol class="regions">
        {
          REGIONS.map((r, i) => (
            <li>
              <span class="rank">{i + 1}</span>
              <span class="region-name">{regionName(r, lang)}</span>
              <span class="region-note">{regionNote(r, lang)}</span>
            </li>
          ))
        }
      </ol>
      <p class="note">{s.regions.note}</p>
    </section>

    <section class="corrections" id="corrections">
      <h2>{s.corrections.title}</h2>
      <p>{s.corrections.body}</p>
      <p><a href={OPERATOR.contactUrl} rel="noopener">{s.corrections.link}</a></p>
    </section>

    <section class="publisher" id="publisher">
      <h2>{s.publisher.title}</h2>
      <dl>
        <dt>{s.publisher.site}</dt>
        <dd>{SITE_NAME}</dd>
        <dt>{s.publisher.publishedBy}</dt>
        <dd>{OPERATOR.name}</dd>
        <dt>{s.publisher.representative}</dt>
        <dd>{OPERATOR.representative}（{AUTHOR.nameJa}）</dd>
        <dt>{s.publisher.address}</dt>
        <dd>{s.publisher.addressLine(OPERATOR.address)}<br /><span class="ja">{OPERATOR.addressJa}</span></dd>
        <dt>{s.publisher.contact}</dt>
        <dd><a href={OPERATOR.contactUrl} rel="noopener">{s.publisher.contactForm}</a></dd>
      </dl>
      <p class="note">{s.publisher.note(OPERATOR.name)}</p>
    </section>
  </div>

  <aside class="side" aria-label={s.side.label}>
    <div class="side-inner">
      <section class="box creds">
        <h2>{s.side.numbers}</h2>
        {
          credentials.map((c) => (
            <div class="cred">
              <span class="cred-value">{c.value}</span>
              <span class="cred-label">{c.label}</span>
            </div>
          ))
        }
      </section>
      <nav class="box toc" aria-label={s.side.onThisPage}>
        <h2>{s.side.onThisPage}</h2>
        <ol>
          <li><a href="#why">{s.why.title}</a></li>
          <li><a href="#travel">{s.travel.title}</a></li>
          <li><a href="#work">{s.work.title}</a></li>
          {hasAnyAffiliate && <li><a href="#money">{s.money.title}</a></li>}
          <li><a href="#regions">{s.regions.title}</a></li>
          <li><a href="#corrections">{s.corrections.title}</a></li>
          <li><a href="#publisher">{s.publisher.title}</a></li>
        </ol>
      </nav>
      <a class="box contact" href={OPERATOR.contactUrl} rel="noopener">
        <span class="contact-title">{s.side.contactTitle}</span>
        <span class="contact-dek">{s.side.contactDek}</span>
        <span class="contact-go">{s.side.contactGo}</span>
      </a>
    </div>
  </aside>
  </div>
</Base>

<style>
  .hero {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .hero-inner {
    display: flex;
    gap: 40px;
  }
  .portrait {
    flex: 0 0 min(400px, 38%);
    border: 1px solid var(--line);
    margin-block: 32px;
  }
  .intro {
    flex: 1 1 auto;
    min-width: 0;
    padding: 40px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  .kicker {
    margin: 0;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    font-size: 42px;
    line-height: 1.1;
  }
  .lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
  }

  /* 実績の帯は SP だけ。PC は右カラム */
  .credentials {
    display: none;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .cred-inner {
    display: flex;
  }
  .cred-inner > div {
    flex: 1 1 0;
    min-width: 0;
    padding: 22px 30px 22px 0;
    border-right: 1px solid var(--line);
  }
  .cred-inner > div:last-child {
    border-right: none;
  }
  .cred-value {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    color: var(--accent);
  }
  .cred-label {
    font-size: 15px;
    color: var(--ink-2);
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 880px) 280px;
    column-gap: 40px;
    align-items: start;
    justify-content: start;
    padding-block: 36px 0;
  }
  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  .side {
    min-width: 0;
    align-self: stretch;
  }
  .side-inner {
    position: sticky;
    top: 16px;
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    scrollbar-width: thin;
  }
  .box {
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .box h2 {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: none;
    padding: 0;
    margin: 0 0 10px;
  }
  .cred {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border-bottom: 1px solid var(--line-2);
  }
  .cred:last-child {
    border-bottom: 0;
  }
  .creds .cred-value {
    font-size: 26px;
  }
  .creds .cred-label {
    font-size: 14px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: toc;
  }
  .toc li a {
    display: flex;
    gap: 10px;
    padding: 7px 0;
    font-size: 15px;
    line-height: 1.4;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }
  .toc li:last-child a {
    border-bottom: 0;
  }
  .toc li a::before {
    counter-increment: toc;
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    padding-top: 3px;
  }
  .toc li a:hover {
    color: var(--accent);
  }
  .contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px 16px;
    border: 1px solid var(--accent);
    background: var(--surface-2);
    color: inherit;
    text-decoration: none;
  }
  .contact:hover {
    background: var(--surface);
  }
  .contact-title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }
  .contact-dek {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .contact-go {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }
  .body h2 {
    font-size: 28px;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 10px;
    margin-bottom: 14px;
  }
  .body p {
    margin: 0 0 1em;
    font-size: 18px;
    line-height: var(--prose-leading);
    color: var(--ink-3);
  }
  .body p:last-child {
    margin-bottom: 0;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 40px;
  }
  .principles h3 {
    font-size: 20px;
    border-top: 3px solid var(--accent);
    padding-top: 12px;
    margin-bottom: 7px;
  }
  .principles p {
    font-size: 17px;
  }

  .money {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    padding: 24px 26px;
  }
  .money h2 {
    font-size: 22px;
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 10px;
  }

  .regions {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    counter-reset: none;
  }
  .regions li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    border-bottom: 1px solid var(--line);
    padding: 11px 0;
    font-size: 17px;
  }
  .rank {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    width: 20px;
    flex-shrink: 0;
  }
  .region-name {
    font-weight: 600;
    flex: 0 0 240px;
  }
  .region-note {
    color: var(--ink-2);
    min-width: 0;
  }

  .publisher dl {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 0;
    margin: 0;
  }
  .publisher dt {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .publisher dd {
    margin: 0;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
    font-size: 17px;
  }
  .ja {
    font-family: var(--font-jp);
    font-size: 15px;
    color: var(--muted-2);
  }
  .note {
    margin-top: 14px !important;
    font-size: 15px !important;
    color: var(--muted-2) !important;
  }

  @media (max-width: 767px) {
    .regions li {
      flex-wrap: wrap;
      gap: 4px 12px;
    }
    .region-name {
      flex: 0 0 auto;
    }
    .region-note {
      flex: 1 0 100%;
      padding-left: 34px;
      font-size: 15px;
    }
  }

  @media (max-width: 1023px) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .credentials {
      display: block;
    }
    .side {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      flex-direction: column;
      gap: 0;
    }
    .portrait {
      flex: none;
      width: 100%;
      aspect-ratio: 3 / 2;
      margin-block: 20px 0;
    }
    .intro {
      padding: 24px 0;
    }
    h1 {
      font-size: 30px;
    }
    .cred-inner {
      flex-wrap: wrap;
    }
    .cred-inner > div {
      flex: 1 1 45%;
      padding: 16px 16px 16px 0;
    }
    .principles {
      grid-template-columns: 1fr;
    }
    .publisher dl {
      grid-template-columns: 1fr;
    }
    .publisher dt {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>
