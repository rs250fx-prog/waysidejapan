---
import Base from './Base.astro';
import RateNote from '../components/RateNote.astro';
import Icon from '../components/Icon.astro';
import { AUTHOR, SITE_URL, hasAnyAffiliate, type Locale } from '../config.ts';
import { t, type UIKey } from '../i18n/ui.ts';
import { formatMonth } from '../lib/money.ts';
import { shouldNoindex, hrefOf, type Article } from '../lib/content.ts';
import { dishHub } from '../lib/lineages.ts';
import { IS_PUBLIC } from '../config.ts';
import { getImage } from 'astro:assets';

interface Props {
  entry: Article;
  locale: Locale;
  alternates?: { locale: string; path: string }[];
}

const { entry, locale, alternates = [] } = Astro.props;
const d = entry.data;
const url = new URL(hrefOf(entry), SITE_URL).href;
// 系譜ページは品目ハブの下にぶら下がる。ハブが無ければ普通のパンくず
const hub = d.kind === 'lineage' && d.dish ? await dishHub(locale, d.dish) : null;

// 記事が自前の画像を持てば、共有画像と構造化データの image に使う。
// 3:2 のまま 1200px 幅に縮める。OG の推奨 1.91:1 ではないが、切り抜いて図の文字を欠くよりよい
const hero = d.heroImage ? await getImage({ src: d.heroImage, width: 1200, format: 'jpg' }) : null;
const ogImage = hero
  ? { src: hero.src, width: Number(hero.attributes.width), height: Number(hero.attributes.height), alt: d.heroAlt }
  : '/og-default.png';

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    ...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
    author: { '@id': `${SITE_URL}/#author` },
    publisher: { '@id': `${SITE_URL}/#publisher` },
    // 自前の画像が無い記事は共有用の既定画像を指す
    image: new URL(typeof ogImage === 'string' ? ogImage : ogImage.src, SITE_URL).href,
    mainEntityOfPage: url,
    inLanguage: locale,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(`/${locale}/`, SITE_URL).href },
      {
        '@type': 'ListItem',
        position: 2,
        name: t(locale, `nav.${d.category}` as UIKey),
        item: new URL(`/${locale}/${d.category}/`, SITE_URL).href,
      },
      ...(hub
        ? [{ '@type': 'ListItem', position: 3, name: hub.data.title, item: new URL(hrefOf(hub), SITE_URL).href }]
        : []),
      { '@type': 'ListItem', position: hub ? 4 : 3, name: d.title, item: url },
    ],
  },
];

if (d.faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base
  locale={locale}
  title={d.title}
  description={d.description}
  noindex={shouldNoindex(entry, IS_PUBLIC)}
  alternates={alternates}
  graph={graph}
  ogType="article"
  ogImage={ogImage}
  publishedTime={d.pubDate.toISOString()}
  modifiedTime={d.updatedDate?.toISOString()}
>
  <article class="wrap article">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={`/${locale}/`}>Home</a>
      <span aria-hidden="true">›</span>
      <a href={`/${locale}/${d.category}/`}>{t(locale, `nav.${d.category}` as UIKey)}</a>
      {hub && (
        <>
          <span aria-hidden="true">›</span>
          <a href={hrefOf(hub)}>{hub.data.title.split(':')[0]}</a>
        </>
      )}
    </nav>

    <h1>{d.title}</h1>

    {
      /* 根拠の強さが見た目で分かるようにする。
         visited は「行った」の証跡と確認日バッジ、researched は出典の本数。
         同じ装飾を両方に付けると、本当に行った記事の価値まで下がる */
    }
    <div class="byline">
      <span class="avatar" aria-hidden="true"><Icon name="about" /></span>
      <span>
        <strong>{AUTHOR.name}</strong> · {AUTHOR.credential}
        {d.basis === 'visited' && d.experience && <> · Rode this route {d.experience.visitedOn}</>}
      </span>
      {
        d.basis === 'visited' ? (
          <span class="badge-verified">
            <Icon name="verified" /> {t(locale, 'article.verified')} {formatMonth(d.pricesCheckedOn)}
          </span>
        ) : (
          <span class="badge-researched">
            <Icon name="sources" /> Researched · {d.sources.length} {d.sources.length === 1 ? 'source' : 'sources'}
          </span>
        )
      }
    </div>

    {
      /* 調べて書いた記事は、本文に入る前にそう言う。
         このサイトの他の記事は一次体験で立っているので、黙ると読者を誤らせる */
      d.basis === 'researched' && (
        <p class="basis-note">
          I have not been to every place in this guide. The figures below are taken from the sources listed at the end,
          with the date each one was published — not measured by me. Where I have been, the article says so.
        </p>
      )
    }

    {
      /* 提携が1つも無いあいだは開示も出さない。出すものが無いのに開示だけ出すのは嘘になる */
      hasAnyAffiliate && <p class="disclosure">{t(locale, 'disclosure.inline')}</p>
    }

    <div class="prose">
      <slot />
    </div>

    {
      d.faq.length > 0 && (
        <section class="faq">
          <h2>{t(locale, 'article.faq')}</h2>
          {d.faq.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      d.sources.length > 0 && (
        <section class="sources">
          <h2>{t(locale, 'article.sources')}</h2>
          <ul>
            {d.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <RateNote pricesCheckedOn={d.pricesCheckedOn} />
  </article>
</Base>

<style>
  .article {
    max-width: 880px;
    padding-block: 32px 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
  }
  .crumbs a {
    color: var(--muted);
  }
  h1 {
    font-size: 44px;
    line-height: 1.1;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 16px;
    border-block: 1px solid var(--line);
    padding-block: 14px;
  }
  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #efe6d6;
    border: 1px solid #ded3bf;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 17px;
  }
  .badge-researched {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
    border: 1px solid var(--line);
    background: var(--surface-2);
    padding: 4px 9px;
  }
  .basis-note {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted-2);
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--muted);
    padding: 14px 16px;
  }
  .disclosure {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    font-style: italic;
    color: var(--muted-2);
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
  }
  .faq h2,
  .sources h2 {
    font-size: 30px;
    margin-bottom: 14px;
  }
  .faq-item {
    border-top: 1px solid var(--line);
    padding-top: 13px;
    margin-bottom: 14px;
  }
  .faq-item h3 {
    font-family: var(--font-body);
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 5px;
  }
  .faq-item p {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .sources {
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 22px 24px;
  }
  .sources ul {
    margin: 0;
    padding-left: 20px;
    line-height: 2;
  }

  @media (max-width: 767px) {
    h1 {
      font-size: 30px;
    }
  }
</style>
