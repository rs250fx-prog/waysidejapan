---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import DemoRibbon from '../components/DemoRibbon.astro';
import { SITE_NAME, TAGLINE, NAV, GA4_MEASUREMENT_ID, DEFAULT_LOCALE, hasAnyAffiliate } from '../config.ts';
import { t, type UIKey } from '../i18n/ui.ts';

interface Props {
  title: string;
  description: string;
  bareTitle?: boolean;
  locale?: string;
  noindex?: boolean;
  alternates?: { locale: string; path: string }[];
  graph?: Record<string, unknown>[];
}

const { locale = DEFAULT_LOCALE, ...seo } = Astro.props;
const nav = NAV.filter((n) => n.enabled);
const here = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
    />
    <Seo locale={locale} {...seo} />
    {
      /* 測定IDが空なら計測タグは出ない。プライバシーポリシーの該当節も同じフラグで消える */
      GA4_MEASUREMENT_ID && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
    <DemoRibbon />

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href={`/${locale}/`}>
          <span class="brand-name">{SITE_NAME}</span>
          <span class="brand-tag">{TAGLINE}</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {
            nav.map((n) => (
              <a
                href={`/${locale}/${n.key}/`}
                class:list={['nav-link', { current: here.startsWith(`/${locale}/${n.key}/`) }]}
              >
                {t(locale, `nav.${n.key}` as UIKey)}
              </a>
            ))
          }
          <a class="nav-link muted" href={`/${locale}/about/`}>{t(locale, 'nav.about')}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <div class="brand-name">{SITE_NAME}</div>
          <p class="footer-line">
            Written in Japan by someone who rode it.
            {hasAnyAffiliate && ' Some links are affiliate links; they never change what gets recommended.'}
          </p>
        </div>
        <nav class="footer-nav" aria-label="Site information">
          {hasAnyAffiliate && <a href={`/${locale}/disclosure/`}>{t(locale, 'footer.disclosure')}</a>}
          <a href={`/${locale}/privacy/`}>{t(locale, 'footer.privacy')}</a>
          <a href={`/${locale}/about/`}>{t(locale, 'nav.about')}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .masthead-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px 16px;
  }
  .brand {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  .brand-tag {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }
  .nav-link {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav-link.current {
    border-bottom: 2px solid var(--accent);
  }
  .nav-link.muted {
    color: var(--muted);
  }

  .footer {
    margin-top: 56px;
    background: var(--surface-2);
    border-top: 1px solid var(--line);
  }
  .footer-inner {
    display: flex;
    gap: 40px;
    justify-content: space-between;
    padding-block: 26px 30px;
    flex-wrap: wrap;
  }
  .footer-line {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted-2);
    max-width: 460px;
  }
  .footer-nav {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }
  .footer-nav a {
    font-size: 15px;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 767px) {
    .masthead-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .nav {
      gap: 18px;
    }
  }
</style>
