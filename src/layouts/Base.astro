---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import DemoRibbon from '../components/DemoRibbon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME, TAGLINE, NAV, ROUTES, GA4_MEASUREMENT_ID, DEFAULT_LOCALE, hasAnyAffiliate } from '../config.ts';
import { t, type UIKey } from '../i18n/ui.ts';

interface Props {
  title: string;
  description: string;
  bareTitle?: boolean;
  locale?: string;
  noindex?: boolean;
  alternates?: { locale: string; path: string }[];
  graph?: Record<string, unknown>[];
  /** 記事ページだけ 'article'。公開日・更新日とセットで渡す */
  ogType?: 'website' | 'article';
  ogImage?: string | { src: string; width: number; height: number; alt?: string };
  publishedTime?: string;
  modifiedTime?: string;
}

const { locale = DEFAULT_LOCALE, ...seo } = Astro.props;
const nav = NAV.filter((n) => n.enabled);
const here = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* マークを変えたら tools/brand/site-icon-source.webp を差し替え、node tools/make-icons.mjs で作り直す */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* 書体は自己ホスト（global.css の @font-face）。最初の描画で使う1本だけ先読みする */}
    <link rel="preload" href="/fonts/source-serif-4-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
    <Seo locale={locale} {...seo} />
    {
      /* 測定IDが空なら計測タグは出ない。プライバシーポリシーの該当節も同じフラグで消える */
      GA4_MEASUREMENT_ID && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
    <DemoRibbon />

    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href={`/${locale}/`}>
          {/* 赤い日と丘を抜ける道。ファビコンと同じ1枚（tools/make-icons.mjs が書き出す） */}
          <img class="brand-mark" src="/icon-192.png" width="38" height="38" alt="" />
          <span class="brand-text">
            <span class="brand-name">{SITE_NAME}</span>
            <span class="brand-tag">{TAGLINE}</span>
          </span>
        </a>
        <nav class="nav" aria-label="Sections">
          {
            nav.map((n) => (
              <a
                href={`/${locale}/${n.key}/`}
                class:list={['nav-link', { current: here.startsWith(`/${locale}/${n.key}/`) }]}
              >
                {t(locale, `nav.${n.key}` as UIKey)}
              </a>
            ))
          }
          {
            /* 価格基準は全ページから常時たどれるようにする。
               どの記事にも金額が出るので、参照先が常に一手で開ける必要がある */
            ROUTES.foodPrices && (
              <a
                href={`/${locale}/food-prices/`}
                class:list={['nav-link', { current: here.startsWith(`/${locale}/food-prices/`) }]}
              >
                Prices
              </a>
            )
          }
          <a class="nav-link muted" href={`/${locale}/about/`}>{t(locale, 'nav.about')}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <SiteFooter locale={locale} />
  </body>
</html>

<style>
  .masthead {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px 16px;
  }
  .brand {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .brand-mark {
    width: 38px;
    height: 38px;
    flex: none;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  .brand-tag {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }
  .nav-link {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav-link.current {
    border-bottom: 2px solid var(--accent);
  }
  .nav-link.muted {
    color: var(--muted);
  }

  @media (max-width: 767px) {
    .masthead-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    /* 折り返して2段になると見出しが下がるので、1段のまま横に送る */
    .nav {
      gap: 20px;
      flex-wrap: nowrap;
      overflow-x: auto;
      max-width: 100%;
      scrollbar-width: none;
    }
    .nav-link {
      flex: none;
    }
  }
</style>
