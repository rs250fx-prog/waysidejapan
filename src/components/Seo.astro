---
/**
 * title / description / canonical / OG / hreflang / JSON-LD を1か所に集約する。
 * ページ側で meta を直書きしない。
 */
import { SITE_NAME, SITE_URL, IS_PUBLIC, AUTHOR, OPERATOR, DEFAULT_LOCALE } from '../config.ts';

interface Props {
  title: string;
  description: string;
  /** サイト名を付けない（トップページ用） */
  bareTitle?: boolean;
  locale?: string;
  noindex?: boolean;
  /** 既定は public/og-default.png（1200×630）。tools/make-icons.mjs が書き出す */
  ogImage?: string;
  /** 記事ページだけ 'article' */
  ogType?: 'website' | 'article';
  /** ISO 8601。ogType が article のときに出す */
  publishedTime?: string;
  modifiedTime?: string;
  /** 実在する他言語版だけ渡す */
  alternates?: { locale: string; path: string }[];
  /** @graph に足す追加ノード（Article / BreadcrumbList / FAQPage） */
  graph?: Record<string, unknown>[];
}

const {
  title,
  description,
  bareTitle = false,
  locale = DEFAULT_LOCALE,
  noindex = false,
  ogImage = '/og-default.png',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  alternates = [],
  graph = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const fullTitle = bareTitle ? title : `${title} | ${SITE_NAME}`;
const ogUrl = new URL(ogImage, SITE_URL).href;
const isDefaultOg = ogImage === '/og-default.png';

// IS_PUBLIC が false のあいだは無条件で noindex（public/_headers の X-Robots-Tag とセット）
const robots = !IS_PUBLIC || noindex ? 'noindex, nofollow' : 'index, follow';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      inLanguage: locale,
      publisher: { '@id': `${SITE_URL}/#publisher` },
    },
    {
      // 発行元。記事の publisher はここを指す
      '@type': 'Organization',
      '@id': `${SITE_URL}/#publisher`,
      name: OPERATOR.name,
      url: OPERATOR.url,
      logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', SITE_URL).href, width: 180, height: 180 },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#author`,
      name: AUTHOR.name,
      description: AUTHOR.credential,
      url: new URL(AUTHOR.url, SITE_URL).href,
      worksFor: { '@id': `${SITE_URL}/#publisher` },
      ...(AUTHOR.sameAs.length > 0 && { sameAs: AUTHOR.sameAs }),
    },
    ...graph,
  ],
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

{alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.path, SITE_URL).href} />)}
{alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(`/${DEFAULT_LOCALE}/`, SITE_URL).href} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
{isDefaultOg && <meta property="og:image:width" content="1200" />}
{isDefaultOg && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={isDefaultOg ? `${SITE_NAME} — what Japan eats, and why` : title} />
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && <meta property="article:author" content={new URL(AUTHOR.url, SITE_URL).href} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
