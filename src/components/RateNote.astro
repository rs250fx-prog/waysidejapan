---
/**
 * 為替の基準日と料金の確認月を、記事の末尾で1回だけ出す。
 * 各金額に基準日を付けると本文が読めなくなるので、必ずここに集約する。
 */
import { jpyPer, ratesAsOf, formatAsOf, formatMonth } from '../lib/money.ts';
import { ROUTES, DEFAULT_LOCALE, currenciesOf } from '../config.ts';
import { localePath } from '../i18n/index.ts';
import { strings } from '../i18n/pages/components.ts';

interface Props {
  pricesCheckedOn?: Date;
  /** 運賃を載せた記事だけが持つ。rail 以外で "Fares verified" を出す条件 */
  faresCheckedOn?: Date;
  /** rail は運賃が本題なので、pricesCheckedOn を運賃の確認日として扱う */
  category?: string;
  locale?: string;
}
const { pricesCheckedOn, faresCheckedOn, category, locale = DEFAULT_LOCALE } = Astro.props;
/* 運賃を載せていない記事に "Fares verified" を出すと本文と矛盾する（監査 SUMMARY §1-3） */
const faresOn = faresCheckedOn ?? (category === 'rail' ? pricesCheckedOn : undefined);

/* 表示する通貨ぶんだけ「¥xx to the euro」を並べる。文言は src/i18n/pages/components.ts（rateNote） */
const s = strings(locale).rateNote;
const shown = currenciesOf(locale).filter((c) => s.currencyNames[c]);
const rateText = s.join(shown.map((c) => s.rate(jpyPer(c), s.currencyNames[c])));
const usesTwd = shown.includes('TWD');
---

<p class="rate-note">
  {s.body(rateText, formatAsOf(ratesAsOf, locale), usesTwd)}
  {
    faresOn ? (
      <> {s.faresVerified(formatMonth(faresOn, locale))}</>
    ) : (
      pricesCheckedOn && <> {s.pricesChecked(formatMonth(pricesCheckedOn, locale))}</>
    )
  }
  {
    /* 金額が出たページからは、必ず価格基準へ戻れるようにする。
       バナーではなく注記の延長に置くことで、読む流れを切らずに常時出せる */
    ROUTES.foodPrices && (
      <>
        {' '}
        <a href={localePath(locale, '/food-prices/')}>{s.foodPrices}</a>
      </>
    )
  }
</p>

<style>
  .rate-note {
    margin: 0;
    padding: 16px 18px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted-2);
  }
</style>
