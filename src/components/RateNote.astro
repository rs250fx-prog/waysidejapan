---
/**
 * 為替の基準日と料金の確認月を、記事の末尾で1回だけ出す。
 * 各金額に基準日を付けると本文が読めなくなるので、必ずここに集約する。
 */
import { jpyPerUsd, ratesAsOf, formatAsOf, formatMonth } from '../lib/money.ts';

interface Props {
  pricesCheckedOn?: Date;
}
const { pricesCheckedOn } = Astro.props;
---

<p class="rate-note">
  Prices are in Japanese yen. Conversions are approximate, at ¥{jpyPerUsd()} to the US dollar as of {formatAsOf(ratesAsOf)}.
  {pricesCheckedOn && <> Fares verified {formatMonth(pricesCheckedOn)} — check the operator before you travel.</>}
</p>

<style>
  .rate-note {
    margin: 0;
    padding: 16px 18px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted-2);
  }
</style>
