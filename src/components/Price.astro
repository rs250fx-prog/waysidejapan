---
/**
 * 円を概算換算つきで表示する。
 * 本文に換算後の金額を直接書かないこと（tools/check-content.mjs が $ の直書きを弾く）。
 *
 * <Price jpy={22000} />        → ¥22,000 (≈ $148 / €137)
 * <Price jpy={700} yenOnly />  → ¥700
 */
import { formatJpy, formatPrice } from '../lib/money.ts';
import { currenciesOf, DEFAULT_LOCALE } from '../config.ts';
import { strings } from '../i18n/pages/components.ts';

interface Props {
  jpy: number;
  yenOnly?: boolean;
  from?: boolean;
}

const { jpy, yenOnly = false, from = false } = Astro.props;
// 言語ごとの通貨で換算する（韓国語は ₩、繁体字は NT$ を先に。config.ts の LOCALE_META）
const locale = Astro.currentLocale ?? DEFAULT_LOCALE;
const text = yenOnly ? formatJpy(jpy) : formatPrice(jpy, currenciesOf(locale));
const s = strings(locale).price;
---

<span class="price" data-jpy={jpy}>{from ? s.from : ''}{text}</span>
