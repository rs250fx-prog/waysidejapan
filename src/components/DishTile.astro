---
/**
 * 品目ハブのタイル。/en/eat/ の目次で使う。
 *
 * 上段は「絵」：heroImage があれば写真、無ければ地色に薄い漢字1字。どちらも 3:2 で高さが揃う。
 * 名前は絵の左上に札（Label.astro と同じ形）で載せ、絵の下には繰り返さない。
 * 下段に系譜ページをチップで並べ、171本の一覧を「39タイル＋系譜リンク」に圧縮する。
 * 系譜の表示名は src/data/lineages/<dish>.json の name（記事タイトルは長すぎる）。
 *
 * SP では絵を左の 64px 正方形に畳み、名前は札ではなく普通の見出しとして横に出す
 * （.visual を display: contents にして、中身をグリッドに直接置く）。
 * 系譜チップは 40px 以上の高さでタップできる。ハブへのリンクは上段だけにして、
 * チップとの押し間違いを防ぐ。
 */
import { Image } from 'astro:assets';
import type { Article } from '../lib/content.ts';
import { hrefOf } from '../lib/content.ts';
import { lineagesOf } from '../lib/lineages.ts';
import { GLYPHS } from '../data/genres.ts';
import { IMAGE_SPEC } from '../lib/images.ts';
import Icon from './Icon.astro';

interface Props {
  hub: Article;
  /** この品目の系譜ページ（公開済みのもの） */
  lineages: Article[];
  /** Start here の大判 */
  large?: boolean;
}
const { hub, lineages, large = false } = Astro.props;
const dish = hub.data.dish ?? '';
const data = lineagesOf(dish);

/** 「Ramen: what it is, …」の前半を品目名に。コロンが無ければ JSON の name、それも無ければタイトル */
const name = hub.data.title.split(/[:：]/)[0].trim() || data?.name || hub.data.title;
const nameJa = data?.nameJa ?? '';
/** 説明は1文目だけ */
const tagline = hub.data.description.split(/(?<=[.!?])\s+/)[0];
const glyph = GLYPHS[dish] ?? name.charAt(0);

const lineageName = (a: Article) => data?.lineages.find((l) => l.key === a.data.lineage)?.name ?? a.data.title.split(/[:：]/)[0];
const links = lineages
  .map((a) => ({ href: hrefOf(a), name: lineageName(a) }))
  .sort((x, y) => x.name.localeCompare(y.name));
const spec = IMAGE_SPEC.card;
---

<article class:list={['tile', { large, photo: !!hub.data.heroImage }]}>
  <a class="face" href={hrefOf(hub)}>
    <span class="visual">
      {
        hub.data.heroImage ? (
          <span class="pic">
            <Image src={hub.data.heroImage} alt="" width={spec.widths.at(-1)} widths={spec.widths} sizes={spec.sizes} loading="lazy" />
          </span>
        ) : (
          <span class="glyph" aria-hidden="true">
            {glyph}
          </span>
        )
      }
      <span class="name">
        <span class="name-glyph" lang="ja" aria-hidden="true">
          {glyph}
        </span>
        <span class="name-text">{name}</span>
      </span>
    </span>
    <span class="text">
      {nameJa && (
        <span class="ja" lang="ja">
          {nameJa}
        </span>
      )}
      <span class="tagline">{tagline}</span>
      <span class="go">
        Read the guide <Icon name="arrow" />
      </span>
    </span>
  </a>
  {
    links.length > 0 && (
      <div class="lineages">
        <span class="lin-label">
          {links.length} {links.length === 1 ? 'lineage' : 'lineages'}
        </span>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.name}</a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .face {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .face:hover .go {
    color: var(--accent-hover);
  }
  .face:hover .name {
    background: var(--accent-hover);
  }

  /* 絵。写真でも漢字でも 3:2 で、グリッドの行の高さが揃う */
  .visual {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .pic,
  .pic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .glyph {
    position: absolute;
    right: 6%;
    bottom: -4%;
    font-family: var(--font-jp);
    font-weight: 300;
    font-size: 150px;
    line-height: 1;
    color: var(--accent);
    opacity: 0.16;
    user-select: none;
  }
  .large .glyph {
    font-size: 200px;
  }

  /* 名前は札（Label.astro と同じ形） */
  .name {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: calc(100% - 24px);
    padding: 7px 12px 7px 10px;
    background: var(--accent);
    color: #fff;
    line-height: 1;
    box-shadow: 0 1px 3px rgba(60, 40, 20, 0.25);
  }
  .name-glyph {
    font-family: var(--font-jp);
    font-size: 17px;
    font-weight: 500;
  }
  .name-text {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .large .name-text {
    font-size: 17px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 14px 16px;
  }
  .ja {
    font-family: var(--font-jp);
    font-size: 13px;
    color: var(--muted);
  }
  .tagline {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .large .tagline {
    font-size: 16px;
  }
  /* ハブへ行くことを言葉で示す。面全体が押せると分からない読者のため */
  .go {
    margin-top: 2px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }

  /* 系譜はチップ。小さな下線リンクだと目立たず、SP では押せない */
  .lineages {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--line-2);
    background: var(--surface-2);
  }
  .lin-label {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .lineages ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .lineages a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 13px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    line-height: 1.25;
    color: var(--ink);
    text-decoration: none;
  }
  .lineages a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* SP：絵を左の 64px 正方形に畳み、名前は札ではなく見出しとして横に出す */
  @media (max-width: 767px) {
    .face {
      display: grid;
      grid-template-columns: 64px minmax(0, 1fr);
      grid-template-areas:
        'v n'
        'v t';
      column-gap: 14px;
      row-gap: 4px;
      padding: 14px;
    }
    .visual {
      display: contents;
    }
    .pic,
    .glyph {
      grid-area: v;
      position: static;
      width: 64px;
      height: 64px;
      aspect-ratio: 1;
      border: 1px solid var(--line);
      background: var(--surface-2);
    }
    .glyph,
    .large .glyph {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 38px;
      opacity: 0.55;
    }
    .name {
      grid-area: n;
      position: static;
      display: block;
      max-width: none;
      padding: 0;
      background: none;
      color: var(--ink);
      box-shadow: none;
    }
    .face:hover .name {
      background: none;
    }
    .name-glyph {
      display: none;
    }
    .name-text,
    .large .name-text {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: 0;
      text-transform: none;
      line-height: 1.2;
    }
    .text {
      grid-area: t;
      padding: 0;
    }
    .tagline,
    .large .tagline {
      font-size: 14px;
    }
    .lineages {
      padding: 10px 14px 14px;
    }
  }
</style>
