---
/**
 * 記事冒頭の結論ボックス。誰に向くか・向かないか・総額を先に出し切る。
 * 「向かない」を書かない記事は宣伝に見えるので、buyIf / skipIf は両方必須。
 */
interface Props {
  buyIf: string;
  skipIf: string;
  totalLabel?: string;
}
const { buyIf, skipIf, totalLabel = 'Week total' } = Astro.props;
---

<section class="verdict">
  <h2>The short answer</h2>
  <div class="cols">
    <div>
      <span class="label yes">Buy it if</span>
      <p>{buyIf}</p>
    </div>
    <div>
      <span class="label no">Skip it if</span>
      <p>{skipIf}</p>
    </div>
    <div>
      <span class="label">{totalLabel}</span>
      <p><slot /></p>
    </div>
  </div>
</section>

<style>
  .verdict {
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--accent);
    padding: 24px 26px;
    margin-block: 26px;
  }
  .verdict > h2 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .cols {
    display: flex;
    gap: 20px;
  }
  .cols > div {
    flex: 1 1 0;
    min-width: 0;
    padding-right: 20px;
    border-right: 1px solid var(--line-2);
  }
  .cols > div:last-child {
    border-right: none;
    padding-right: 0;
  }
  .label {
    display: block;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    margin-bottom: 6px;
  }
  /* 緑は「確認済み・肯定」の符号として予約している色。ここだけで使う */
  .label.yes {
    color: var(--confirm);
  }
  /* 警告に別の暖色を当てない。アクセントと混ざって意味が読めなくなる */
  .label.no {
    color: var(--muted-2);
  }
  .cols p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  @media (max-width: 767px) {
    .cols {
      flex-direction: column;
      gap: 14px;
    }
    .cols > div {
      padding-right: 0;
      border-right: none;
      border-top: 1px solid var(--line-2);
      padding-top: 12px;
    }
    .cols > div:first-child {
      border-top: none;
      padding-top: 0;
    }
  }
</style>
