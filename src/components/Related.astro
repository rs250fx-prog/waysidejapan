---
/**
 * 関連記事。サムネイル付きのカードを3枚。
 * 文字だけのリンクより押されやすく、次の1本へ自然に送れる。選び方は lib/content.ts の relatedOf
 *
 * variant
 *   grid … 本文末尾に3列（SP は1列）
 *   rail … 記事ページの右カラム用。縦に積んだバナー（絵は列幅いっぱい、題名はその下）
 * カテゴリ名はサムネの左上の札（Label.astro）。サムネの下には繰り返さない
 */
import Thumb from './Thumb.astro';
import Label from './Label.astro';
import { relatedOf, hrefOf, type Article } from '../lib/content.ts';
import { t, type UIKey } from '../i18n/ui.ts';
import type { Locale } from '../config.ts';

interface Props {
  entry: Article;
  locale: Locale;
  variant?: 'grid' | 'rail';
}
const { entry, locale, variant = 'grid' } = Astro.props;
const items = await relatedOf(entry);
---

{
  items.length > 0 && (
    <section class:list={['related', variant]} aria-labelledby="related-title">
      <h2 id="related-title">Read next</h2>
      <div class="related-grid">
        {items.map((a) => (
          <a class="related-card" href={hrefOf(a)}>
            <span class="related-photo">
              <Thumb entry={a} kind="card" />
              <Label icon={a.data.category} text={t(locale, `nav.${a.data.category}` as UIKey)} />
            </span>
            <span class="related-text">
              <span class="related-title">{a.data.title}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related {
    border-top: 2px solid var(--ink);
    padding-top: 16px;
  }
  .related h2 {
    font-size: 26px;
    margin-bottom: 16px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  .related-photo {
    position: relative;
    display: block;
  }
  .related-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .related-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }
  .related-card:hover .related-title {
    text-decoration: underline;
  }

  /* 右カラム版：縦に積んだバナー。絵を列幅いっぱい（3:2）に出し、札を載せ、題名はその下。
     左に小さな正方形を並べた形はクリックされにくかったので改めた（2026-10-21） */
  .rail {
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .rail h2 {
    font-size: 15px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .rail .related-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .rail .related-card {
    gap: 8px;
  }
  .rail .related-title {
    font-size: 16px;
    line-height: 1.35;
  }

  @media (max-width: 767px) {
    .related-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
