---
/**
 * サイトマップ型のフッタ。
 *
 * 実装していないページはリンクにせず「Soon」と出す（ROUTES で管理）。
 * 404 へのリンクを人間の注意力で防ぐのは無理なので、表で防ぐ。
 * 未提携のあいだは開示リンクも出ない（AFFILIATE と連動）。
 * 文言は src/i18n/pages/footer.ts、エリア名は src/i18n/data/areas.ts。
 */
import { SITE_NAME, TAGLINE, NAV, ROUTES, LOCALES, LOCALE_META, PLANNED_LOCALES, hreflangOf, GA4_MEASUREMENT_ID, hasAnyAffiliate, type Locale } from '../config.ts';
import { AREAS } from '../data/areas.ts';
import { t, type UIKey } from '../i18n/ui.ts';
import { localePath } from '../i18n/index.ts';
import { strings } from '../i18n/pages/footer.ts';
import { areaName } from '../i18n/data/areas.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = strings(locale);
const year = new Date().getFullYear();

type Item = { label: string; href?: string; note?: string };

const areaItems: Item[] = AREAS.map((a) => ({
  label: areaName(a, locale),
  href: ROUTES.areaHub && a.status !== 'planned' ? localePath(locale, `/areas/${a.slug}/`) : undefined,
  note: a.status === 'planned' ? s.planned : a.status === 'in-progress' ? s.inProgress : undefined,
}));

const guideItems: Item[] = NAV.map((n) => ({
  label: t(locale, `nav.${n.key}` as UIKey),
  href: n.enabled ? localePath(locale, `/${n.key}/`) : undefined,
  note: n.enabled ? undefined : s.soon,
}));

const planItems: Item[] = [
  { label: s.foodCosts, href: ROUTES.foodPrices ? localePath(locale, '/food-prices/') : undefined, note: ROUTES.foodPrices ? undefined : s.soon },
  { label: s.passes, href: ROUTES.passes ? localePath(locale, '/passes/') : undefined, note: ROUTES.passes ? undefined : s.soon },
  { label: s.itineraries, href: ROUTES.itineraries ? localePath(locale, '/itineraries/') : undefined, note: ROUTES.itineraries ? undefined : s.soon },
  { label: s.budget, note: s.soon },
  { label: t(locale, 'nav.search'), href: ROUTES.search ? localePath(locale, '/search/') : undefined, note: ROUTES.search ? undefined : s.soon },
];

const aboutItems: Item[] = [
  { label: s.whoWrites, href: ROUTES.about ? localePath(locale, '/about/') : undefined, note: ROUTES.about ? undefined : s.soon },
  { label: s.correction, href: ROUTES.contact ? localePath(locale, '/contact/') : undefined, note: ROUTES.contact ? undefined : s.soon },
  ...(hasAnyAffiliate
    ? [{ label: t(locale, 'footer.disclosure'), href: ROUTES.disclosure ? localePath(locale, '/disclosure/') : undefined, note: ROUTES.disclosure ? undefined : s.soon }]
    : []),
  { label: t(locale, 'footer.privacy'), href: ROUTES.privacy ? localePath(locale, '/privacy/') : undefined, note: ROUTES.privacy ? undefined : s.soon },
];

const columns: { title: string; items: Item[] }[] = [
  { title: s.colAreas, items: areaItems },
  { title: s.colGuides, items: guideItems },
  { title: s.colPlan, items: planItems },
  { title: s.colAbout, items: aboutItems },
];

// 計画している言語（config.ts の PLANNED_LOCALES）を並べ、URL を持つ言語（LOCALES）だけリンクにする。
// 中国語は繁体字（台湾向け）だけ。中国本土向けの簡体字は作らない（2026-11-08 の決定）
const languages = PLANNED_LOCALES.map((code) => ({
  code,
  label: LOCALE_META[code].label,
  ready: LOCALES.includes(code),
}));
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="sitemap" aria-label={s.siteMapLabel}>
      {
        columns.map((col) => (
          <div class="col">
            <p class="col-title">{col.title}</p>
            <ul>
              {col.items.map((i) => (
                <li>
                  {i.href ? (
                    <a href={i.href}>{i.label}</a>
                  ) : (
                    <span class="soon">
                      {i.label} <em>{i.note ?? s.soon}</em>
                    </span>
                  )}
                  {i.href && i.note && <em class="tag">{i.note}</em>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="col wide">
        <p class="col-title">{s.letterTitle}</p>
        <p class="blurb">
          {s.letterBlurb}
        </p>
        {
          ROUTES.newsletter ? (
            <form class="signup" method="post" action={localePath(locale, '/subscribe/')}>
              <label class="sr" for="footer-email">
                {s.emailLabel}
              </label>
              <input id="footer-email" name="email" type="email" placeholder="you@example.com" required />
              <button class="btn" type="submit">
                {s.subscribe}
              </button>
            </form>
          ) : (
            <p class="soon-block">
              <em>{s.soon}</em> {s.letterSoon}
            </p>
          )
        }
      </div>
    </nav>

    <div class="statement">
      <div>
        <div class="brand">{SITE_NAME}</div>
        <p>
          {s.statement(TAGLINE)}
          {hasAnyAffiliate && s.affiliateStatement}
        </p>
      </div>
      <div class="langs">
        <p class="col-title">{s.language}</p>
        <ul>
          {
            languages.map((l) => (
              <li>
                {l.ready ? (
                  <a href={localePath(l.code)} hreflang={hreflangOf(l.code)} lang={hreflangOf(l.code)}>
                    {l.label}
                  </a>
                ) : (
                  <span class="soon">
                    {l.label} <em>{s.soon}</em>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="bottom">
      <small>© {year} {SITE_NAME}</small>
      {
        /* 同意の選択を開き直す入口。バナー側（ConsentBanner）が data-consent-open を拾う */
        GA4_MEASUREMENT_ID && (
          <button type="button" class="cookie-settings" data-consent-open>
            {s.cookieSettings}
          </button>
        )
      }
      <a class="totop" href="#main">{s.backToTop}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    background: var(--surface-2);
    border-top: 1px solid var(--line);
    padding-block: 36px 24px;
  }

  .sitemap {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) 1.4fr;
    gap: 32px;
  }
  .col-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.15;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 10px;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .col li {
    border-bottom: 1px solid var(--line-2);
  }
  .col li:last-child {
    border-bottom: none;
  }
  .col a,
  .soon {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 16px;
    text-decoration: none;
    color: var(--ink);
  }
  .col a:hover {
    color: var(--accent);
  }
  /* 未実装のページはリンクにしない。押せないことが見た目で分かるようにする */
  .soon {
    color: var(--muted);
  }
  .soon em,
  .tag {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 2px 6px;
  }
  .blurb {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-2);
  }
  .signup {
    display: flex;
    gap: 8px;
  }
  .signup input {
    flex: 1 1 auto;
    min-width: 0;
    font-family: var(--font-body);
    font-size: 16px;
    padding: 12px 13px;
    border: 1px solid #d8cfbb;
    background: #fff;
    color: var(--ink);
    min-height: 44px;
  }
  .soon-block {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .soon-block em {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid var(--line);
    padding: 2px 6px;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .statement {
    display: flex;
    gap: 40px;
    justify-content: space-between;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  .statement p {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted-2);
    max-width: 620px;
  }
  .brand {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    color: var(--accent);
  }
  .langs ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .langs a,
  .langs .soon {
    font-size: 15px;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 22px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .cookie-settings {
    margin-inline: auto 0;
    padding: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font: inherit;
    font-size: 14px;
    color: var(--ink);
    background: none;
    border: none;
    text-decoration: underline;
    cursor: pointer;
  }
  .totop {
    font-size: 14px;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 1000px) {
    .sitemap {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .col.wide {
      grid-column: 1 / -1;
    }
    .statement {
      flex-direction: column;
      gap: 22px;
    }
  }
  @media (max-width: 560px) {
    .sitemap {
      grid-template-columns: 1fr;
    }
  }
</style>
