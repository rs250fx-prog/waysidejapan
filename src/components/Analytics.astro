---
import { GA4_MEASUREMENT_ID } from '../config.ts';

/**
 * Google Analytics 4（Consent Mode v2）。
 *
 * 測定IDが空のとき、および noindex のページでは何も出力しない。
 *
 * 同意が出るまでは、保存も送信もしない（gtag.js 自体を読み込まない）：
 *   - consent の既定は analytics_storage / ad_* すべて 'denied'
 *   - 同意の選択は localStorage の 'wsj-consent'（'granted' | 'denied'）に残す（書き込みは ConsentBanner）
 *   - 同意済みの再訪では、最初の操作か load から5秒後のどちらか早いほうで gtag.js を読む
 *     （表示が終わるまで本文の描画と帯域を奪い合わせないため）
 *   - 初めての訪問者がバナーで Accept したときは、ConsentBanner が window.wsjLoadGA() を呼ぶ
 *
 * gtag.js を読み込まないのは、Consent Mode の「advanced」だと同意前でも Google へ
 * Cookie なしの通信が飛ぶため。設計書（docs/SPEC.md 第11節）の「同意前に GA4 を動かさない」に合わせる。
 */
const { noindex = false } = Astro.props;
const id = GA4_MEASUREMENT_ID;
---

{id && !noindex && (
  <script is:inline define:vars={{ id }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag() { window.dataLayer.push(arguments); };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });
    window.gtag('js', new Date());
    window.gtag('config', id);

    let loaded = false;
    window.wsjLoadGA = function () {
      if (loaded) return;
      loaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
      document.head.appendChild(s);
    };

    let saved = null;
    try { saved = localStorage.getItem('wsj-consent'); } catch (e) {}
    if (saved === 'granted') {
      window.gtag('consent', 'update', { analytics_storage: 'granted' });
      const events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
      const go = () => {
        events.forEach((e) => removeEventListener(e, go));
        window.wsjLoadGA();
      };
      events.forEach((e) => addEventListener(e, go, { once: true, passive: true }));
      const later = () => setTimeout(go, 5000);
      if (document.readyState === 'complete') later();
      else addEventListener('load', later, { once: true });
    }
  </script>
)}
