---
/**
 * セクション頭の事実行。運賃・所要・乗換など、読者が本文を読まずに拾う数字。
 * 値は入稿の「事実データ」表から来たものだけを渡す。
 */
interface Props {
  items: { label: string; value: string }[];
}
const { items } = Astro.props;
---

<div class="facts">
  {
    items.map((i) => (
      <div class="fact">
        <span class="fact-label">{i.label}</span>
        <span class="fact-value">{i.value}</span>
      </div>
    ))
  }
</div>

<style>
  .facts {
    display: flex;
    border-block: 1px solid var(--line);
    margin-block: 18px;
  }
  .fact {
    flex: 1 1 0;
    min-width: 0;
    padding-block: 13px;
  }
  .fact-label {
    display: block;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .fact-value {
    display: block;
    font-size: 18px;
    padding-top: 4px;
  }

  @media (max-width: 767px) {
    .facts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
    }
    .fact {
      background: var(--bg);
      padding: 10px 12px;
    }
    .fact-value {
      font-size: 16px;
    }
  }
</style>
